From e20b49ccac99d769064f9c58ed6586acceaa1726 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sat, 14 Nov 2026 09:16:27 -0700
Subject: [PATCH 166/166] kernelbase, ntdll: Every Chromium browser draws its UI in
 software.

Steam's web helper and Ubisoft Connect froze under FEX the same way: drawn
through ANGLE (Direct3D 11, or SwiftShader's GL) into their windows, the
windows stopped updating while every thread sat idle. Any other Chromium
program (CEF, Chrome, Edge/WebView2) can do the same, so every Chromium
browser process now gets what fixed those two: no sandbox, the GPU in process
and off, and SwiftShader for WebGL only (--use-angle=swiftshader-webgl), so
its UI composites in software.

kernelbase gives them (CHROMIUM_SOFTWARE_ARGS) to the generic Chromium
browser and to the Steam, Ubisoft Connect, Rockstar Social Club, EA app and
Battle.net rules, which had --in-process-gpu alone; ntdll gives them to a
Chromium browser started directly. A command line that already has
--use-angle=swiftshader-webgl, or a child process (--type=), is left alone.
---
 dlls/kernelbase/launchers.c | 59 ++++++++++++++++---------------------
 dlls/ntdll/unix/env.c       | 36 ++++++++++++++--------
 2 files changed, 49 insertions(+), 46 deletions(-)

diff --git a/dlls/kernelbase/launchers.c b/dlls/kernelbase/launchers.c
index 7432edbfdec..caabc6bc636 100644
--- a/dlls/kernelbase/launchers.c
+++ b/dlls/kernelbase/launchers.c
@@ -29,12 +29,20 @@ struct launcher_process_policy
     const WCHAR *append_args;
 };
 
+/* MetalSharp: what every Chromium browser (CEF, Chrome, Edge/WebView2) gets: no sandbox, the GPU in process and off,
+ * and SwiftShader for WebGL only, so its UI composites in software. With the GPU on, or all of ANGLE on SwiftShader,
+ * Chromium draws its UI through ANGLE (Direct3D 11, or SwiftShader's GL) into its windows, and under FEX those windows
+ * stop updating: the program looks frozen while its threads sit idle (Steam's web helper, Ubisoft Connect). */
+#define CHROMIUM_SOFTWARE_ARGS \
+    L" --no-sandbox --in-process-gpu --disable-gpu --disable-d3d11 --enable-unsafe-swiftshader --use-gl=angle" \
+    L" --use-angle=swiftshader-webgl"
+/* A command line that already has them. */
+#define CHROMIUM_SOFTWARE_MARKER L"--use-angle=swiftshader-webgl"
+
 static const struct launcher_process_policy launcher_process_policies[] =
 {
-    /* WineForge-Internal: launcher-compat/steam-cef-swiftshader-v1.
-     * MetalSharp: SwiftShader for WebGL only (swiftshader-webgl), as MetalSharp's x86_64 runtime starts Steam's
-     * web helper. With all of ANGLE on SwiftShader the browser composites through ANGLE into its windows, which
-     * stop updating under FEX: Steam's window freezes and its watchdog kills the renderers as unresponsive. */
+    /* WineForge-Internal: launcher-compat/steam-cef-swiftshader-v1. Every web helper process, as MetalSharp's x86_64
+     * runtime starts them. */
     {
         L"steamwebhelper.exe",
         L"\\Steam\\bin\\cef\\",
@@ -42,13 +50,7 @@ static const struct launcher_process_policy launcher_process_policies[] =
         NULL,
         NULL,
         {L"--type=crashpad-handler", L"--disable-gpu", NULL},
-        L" --no-sandbox"
-        L" --in-process-gpu"
-        L" --disable-gpu"
-        L" --disable-d3d11"
-        L" --enable-unsafe-swiftshader"
-        L" --use-gl=angle"
-        L" --use-angle=swiftshader-webgl",
+        CHROMIUM_SOFTWARE_ARGS,
     },
     /* WineForge-Internal: launcher-compat/rockstar-cef-in-process-gpu-v1. */
     {
@@ -57,8 +59,8 @@ static const struct launcher_process_policy launcher_process_policies[] =
         L"/Rockstar Games/Social Club/",
         NULL,
         NULL,
-        {L"--type=", L"--in-process-gpu", NULL},
-        L" --in-process-gpu",
+        {L"--type=", CHROMIUM_SOFTWARE_MARKER, NULL},
+        CHROMIUM_SOFTWARE_ARGS,
     },
     /* WineForge-Internal: launcher-compat/ea-app-in-process-gpu-v1. */
     {
@@ -67,8 +69,8 @@ static const struct launcher_process_policy launcher_process_policies[] =
         L"/Program Files/Electronic Arts/EA Desktop/",
         L"\\compatibility32\\",
         L"/compatibility32/",
-        {L"--type=", L"--in-process-gpu", NULL},
-        L" --in-process-gpu",
+        {L"--type=", CHROMIUM_SOFTWARE_MARKER, NULL},
+        CHROMIUM_SOFTWARE_ARGS,
     },
     /* WineForge-Internal: launcher-compat/battlenet-in-process-gpu-v1. */
     {
@@ -77,27 +79,19 @@ static const struct launcher_process_policy launcher_process_policies[] =
         L"/Program Files (x86)/Battle.net/",
         NULL,
         NULL,
-        {L"--type=", L"--in-process-gpu", NULL},
-        L" --in-process-gpu",
+        {L"--type=", CHROMIUM_SOFTWARE_MARKER, NULL},
+        CHROMIUM_SOFTWARE_ARGS,
     },
-    /* WineForge-Internal: launcher-compat/ubisoft-connect-in-process-gpu-v1.
-     * MetalSharp: and SwiftShader for WebGL only, as for Steam's web helper. Otherwise Ubisoft Connect's browser
-     * (upc.exe itself) draws its UI through ANGLE on Direct3D 11, and its window stops updating under FEX. Only the
-     * browser gets these, so its renderers (UplayWebCore.exe --type=...) are left as they are. */
+    /* WineForge-Internal: launcher-compat/ubisoft-connect-in-process-gpu-v1. Its browser is upc.exe itself; its
+     * renderers (UplayWebCore.exe --type=...) are left as they are. */
     {
         L"upc.exe",
         L"\\Program Files (x86)\\Ubisoft\\Ubisoft Game Launcher\\",
         L"/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/",
         NULL,
         NULL,
-        {L"--type=", L"--in-process-gpu", NULL},
-        L" --no-sandbox"
-        L" --in-process-gpu"
-        L" --disable-gpu"
-        L" --disable-d3d11"
-        L" --enable-unsafe-swiftshader"
-        L" --use-gl=angle"
-        L" --use-angle=swiftshader-webgl",
+        {L"--type=", CHROMIUM_SOFTWARE_MARKER, NULL},
+        CHROMIUM_SOFTWARE_ARGS,
     },
 };
 
@@ -183,10 +177,9 @@ const WCHAR *get_launcher_process_args( const WCHAR *app_name, const WCHAR *cmd_
         return policy->append_args;
     }
 
-    /* MetalSharp: any other Chromium browser process. Its GPU process can't draw into the
-     * browser's windows on macOS (they stay blank), so keep the GPU thread in process. */
-    if (!string_contains_ci( cmd_line, L"--type=" ) && !string_contains_ci( cmd_line, L"--in-process-gpu" ) &&
+    /* MetalSharp: any other Chromium browser process (its children take their settings from it). */
+    if (!string_contains_ci( cmd_line, L"--type=" ) && !cmd_line_has_arg( cmd_line, CHROMIUM_SOFTWARE_MARKER ) &&
         is_chromium_browser( app_name ))
-        return L" --in-process-gpu";
+        return CHROMIUM_SOFTWARE_ARGS;
     return NULL;
 }
diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index 262ad955690..27c7e9494a1 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -2480,21 +2480,25 @@ static BOOL wide_starts_with_ascii( const WCHAR *str, const char *prefix )
     return TRUE;
 }
 
-/* MetalSharp: Chromium's GPU process (CEF, Chrome, Edge/WebView2) can't draw into the browser
- * process's windows on macOS, which leaves them blank, so a Chromium browser process started
- * directly gets --in-process-gpu. kernelbase does the same for one started by CreateProcess. */
-static WCHAR **chromium_in_process_gpu( WCHAR **wargv )
+/* MetalSharp: a Chromium browser (CEF, Chrome, Edge/WebView2) started directly gets what kernelbase gives one started
+ * by CreateProcess (launchers.c, CHROMIUM_SOFTWARE_ARGS): no sandbox, the GPU in process and off, and SwiftShader for
+ * WebGL only, so its UI composites in software. Drawn through ANGLE into its windows, it stops updating under FEX. */
+static WCHAR **chromium_software_drawing( WCHAR **wargv )
 {
     static const char *const markers[] = { "libcef.dll", "chrome_elf.dll", "msedge_elf.dll" };
-    static const char flag[] = "--in-process-gpu";
+    static const char *const flags[] = { "--no-sandbox", "--in-process-gpu", "--disable-gpu", "--disable-d3d11",
+                                         "--enable-unsafe-swiftshader", "--use-gl=angle",
+                                         "--use-angle=swiftshader-webgl" };
     const WCHAR *name = wargv[0], *p;
-    WCHAR path[MAX_PATH], **ret;
+    WCHAR path[MAX_PATH], **ret, *text;
     unsigned int argc, i, j, dir_len;
+    size_t chars = 0;
     char *unix_name;
     BOOL found = FALSE;
 
     for (argc = 1; wargv[argc]; argc++)
-        if (wide_starts_with_ascii( wargv[argc], "--type=" ) || wide_starts_with_ascii( wargv[argc], flag ))
+        if (wide_starts_with_ascii( wargv[argc], "--type=" ) ||
+            wide_starts_with_ascii( wargv[argc], "--use-angle=swiftshader-webgl" ))
             return wargv;
     for (p = wargv[0]; *p; p++) if (*p == '\\' || *p == '/') name = p + 1;
     dir_len = name - wargv[0];
@@ -2510,13 +2514,19 @@ static WCHAR **chromium_in_process_gpu( WCHAR **wargv )
     }
     if (!found) return wargv;
 
+    for (i = 0; i < ARRAY_SIZE(flags); i++) chars += strlen( flags[i] ) + 1;
     /* the old array stays allocated: its strings are still referenced */
-    if (!(ret = malloc( (argc + 2) * sizeof(*ret) + sizeof(flag) * sizeof(WCHAR) ))) return wargv;
+    if (!(ret = malloc( (argc + ARRAY_SIZE(flags) + 1) * sizeof(*ret) + chars * sizeof(WCHAR) ))) return wargv;
     memcpy( ret, wargv, argc * sizeof(*ret) );
-    ret[argc] = (WCHAR *)(ret + argc + 2);
-    for (j = 0; j < sizeof(flag); j++) ret[argc][j] = (unsigned char)flag[j];
-    ret[argc + 1] = NULL;
-    TRACE( "Chromium browser %s: adding %s\n", debugstr_w(wargv[0]), flag );
+    text = (WCHAR *)(ret + argc + ARRAY_SIZE(flags) + 1);
+    for (i = 0; i < ARRAY_SIZE(flags); i++)
+    {
+        ret[argc + i] = text;
+        for (j = 0; flags[i][j]; j++) *text++ = (unsigned char)flags[i][j];
+        *text++ = 0;
+    }
+    ret[argc + ARRAY_SIZE(flags)] = NULL;
+    TRACE( "Chromium browser %s: drawing in software\n", debugstr_w(wargv[0]) );
     return ret;
 }
 #endif
@@ -2605,7 +2615,7 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params(void)
 
     main_wargv = build_wargv( get_dos_path( nt_name.Buffer ));
 #ifdef __APPLE__
-    main_wargv = chromium_in_process_gpu( main_wargv );
+    main_wargv = chromium_software_drawing( main_wargv );
 #endif
     cmdline = build_command_line( main_wargv );
 
