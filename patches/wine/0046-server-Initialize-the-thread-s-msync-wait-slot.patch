From c74b82db70cc1b9fd407cde97ca61d36cd9910dd Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Thu, 22 Oct 2026 15:05:43 -0600
Subject: [PATCH 46/55] server: Initialize the thread's msync wait slot.

Thread objects are not zero-filled; the uninitialized field made get_msync_wait_slot
return garbage.
---
 server/thread.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/server/thread.c b/server/thread.c
index 3b1a12e1d15..fb27b8bcdbc 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -355,6 +355,7 @@ static inline void init_thread_structure( struct thread *thread )
     thread->teb             = 0;
     thread->entry_point     = 0;
     thread->system_regs     = 0;
+    thread->msync_wait_slot = 0;
     thread->queue           = NULL;
     thread->wait            = NULL;
     thread->error           = 0;
