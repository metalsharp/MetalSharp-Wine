diff --git a/dlls/msvcrt/errno.c b/dlls/msvcrt/errno.c
index e011eff46aa..27546445e51 100644
--- a/dlls/msvcrt/errno.c
+++ b/dlls/msvcrt/errno.c
@@ -330,6 +330,41 @@ char* CDECL _strerror(const char* str)
     return data->strerror_buffer;
 }
 
+#if _MSVCR_VER >= 80
+
+/**********************************************************************
+ *		_strerror_s	(MSVCR80.@)
+ */
+int CDECL _strerror_s(char *buffer, size_t nc, const char *str)
+{
+    const char *msg;
+    size_t len = 0;
+    int err;
+
+    if (!MSVCRT_CHECK_PMT(buffer != NULL)) return EINVAL;
+    if (!MSVCRT_CHECK_PMT(nc > 0)) return EINVAL;
+
+    err = *_errno();
+    if (err < 0 || err > MSVCRT__sys_nerr) err = MSVCRT__sys_nerr;
+    msg = MSVCRT__sys_errlist[err];
+
+    /* "str: message", or the message alone without str. Unlike _strerror there
+     * is no trailing newline, and the result is truncated to fit the buffer. */
+    buffer[0] = '\0';
+    if (str && *str)
+    {
+        while (*str && len < nc - 1) buffer[len++] = *str++;
+        if (len < nc - 1) buffer[len++] = ':';
+        if (len < nc - 1) buffer[len++] = ' ';
+    }
+    while (*msg && len < nc - 1) buffer[len++] = *msg++;
+    buffer[len] = '\0';
+
+    return 0;
+}
+
+#endif /* _MSVCR_VER >= 80 */
+
 /*********************************************************************
  *		perror (MSVCRT.@)
  */
diff --git a/dlls/ucrtbase/tests/misc.c b/dlls/ucrtbase/tests/misc.c
index 96307151f28..aa4c16e2d8f 100644
--- a/dlls/ucrtbase/tests/misc.c
+++ b/dlls/ucrtbase/tests/misc.c
@@ -19,6 +19,7 @@
 #include <errno.h>
 #include <stdarg.h>
 #include <stdlib.h>
+#include <string.h>
 #include <wchar.h>
 #include <stdio.h>
 #include <math.h>
@@ -2211,6 +2212,34 @@ static void test_rint(void)
     fesetround(rounding_mode);
 }
 
+static void test__strerror_s(void)
+{
+    char buf[256];
+    int ret;
+
+    errno = ENOENT;
+    ret = _strerror_s(buf, sizeof(buf), NULL);
+    ok(!ret, "ret = %d\n", ret);
+    ok(!strcmp(buf, "No such file or directory"), "buf = %s\n", buf);
+
+    errno = ENOENT;
+    ret = _strerror_s(buf, sizeof(buf), "");
+    ok(!ret, "ret = %d\n", ret);
+    ok(!strcmp(buf, "No such file or directory"), "buf = %s\n", buf);
+
+    errno = ENOENT;
+    ret = _strerror_s(buf, sizeof(buf), "open");
+    ok(!ret, "ret = %d\n", ret);
+    ok(!strcmp(buf, "open: No such file or directory"), "buf = %s\n", buf);
+    ok(errno == ENOENT, "errno = %d\n", errno);
+
+    errno = ENOENT;
+    memset(buf, 'x', sizeof(buf));
+    ret = _strerror_s(buf, 8, "open");
+    ok(!ret, "ret = %d\n", ret);
+    ok(!strcmp(buf, "open: N"), "buf = %s\n", buf);
+}
+
 START_TEST(misc)
 {
     int arg_c;
@@ -2265,4 +2294,5 @@ START_TEST(misc)
     test_carg();
     test_cargf();
     test_rint();
+    test__strerror_s();
 }
