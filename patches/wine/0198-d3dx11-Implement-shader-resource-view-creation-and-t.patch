+static HRESULT create_srv_for_texture(ID3D11Device *device, ID3D11Resource *texture,
+        ID3D11ShaderResourceView **view)
+{
+    D3D11_SHADER_RESOURCE_VIEW_DESC desc = { 0 };
+    D3D11_RESOURCE_DIMENSION dimension;
+
+    ID3D11Resource_GetType(texture, &dimension);
+    switch (dimension)
+    {
+        case D3D11_RESOURCE_DIMENSION_TEXTURE2D:
+        {
+            D3D11_TEXTURE2D_DESC tex_desc;
+
+            ID3D11Texture2D_GetDesc((ID3D11Texture2D *)texture, &tex_desc);
+            desc.Format = tex_desc.Format;
+            if (tex_desc.MiscFlags & D3D11_RESOURCE_MISC_TEXTURECUBE)
+            {
+                if (tex_desc.ArraySize > 6)
+                {
+                    desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURECUBEARRAY;
+                    desc.TextureCubeArray.MipLevels = tex_desc.MipLevels;
+                    desc.TextureCubeArray.NumCubes = tex_desc.ArraySize / 6;
+                }
+                else
+                {
+                    desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURECUBE;
+                    desc.TextureCube.MipLevels = tex_desc.MipLevels;
+                }
+            }
+            else if (tex_desc.ArraySize > 1)
+            {
+                desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2DARRAY;
+                desc.Texture2DArray.MipLevels = tex_desc.MipLevels;
+                desc.Texture2DArray.ArraySize = tex_desc.ArraySize;
+            }
+            else
+            {
+                desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+                desc.Texture2D.MipLevels = tex_desc.MipLevels;
+            }
+            break;
+        }
+
+        case D3D11_RESOURCE_DIMENSION_TEXTURE3D:
+        {
+            D3D11_TEXTURE3D_DESC tex_desc;
+
+            ID3D11Texture3D_GetDesc((ID3D11Texture3D *)texture, &tex_desc);
+            desc.Format = tex_desc.Format;
+            desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE3D;
+            desc.Texture3D.MipLevels = tex_desc.MipLevels;
+            break;
+        }
+
+        default:
+            return ID3D11Device_CreateShaderResourceView(device, texture, NULL, view);
+    }
+
+    return ID3D11Device_CreateShaderResourceView(device, texture, &desc, view);
+}
+
+static HRESULT create_srv(ID3D11Device *device, const void *data, SIZE_T size,
+        D3DX11_IMAGE_LOAD_INFO *load_info, ID3D11ShaderResourceView **view)
+{
+    ID3D11Resource *texture;
+    HRESULT hr;
+
+    if (FAILED(hr = create_texture(device, data, size, load_info, &texture)))
+        return hr;
+    hr = create_srv_for_texture(device, texture, view);
+    ID3D11Resource_Release(texture);
+    return hr;
+}
