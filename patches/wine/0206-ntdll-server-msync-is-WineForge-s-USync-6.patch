+
+static void __attribute__((cold,noinline)) msync_leave_masked_scope(void)
+{
+    if (!--msync_lock_depth)
+    {
+        sigset_t previous = msync_lock_sigset;
+
+        pthread_sigmask( SIG_SETMASK, &previous, NULL );
+    }
