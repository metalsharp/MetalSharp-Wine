+static void __attribute__((cold,noinline)) msync_enter_masked_scope(void)
+{
+    sigset_t previous;
+
+    pthread_sigmask( SIG_BLOCK, &server_block_set, &previous );
+    if (!msync_lock_depth) msync_lock_sigset = previous;
+    msync_lock_depth++;
