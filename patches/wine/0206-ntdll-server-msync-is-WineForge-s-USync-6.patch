+    if ((pending & MSYNC_DEFER_USR1) && raise( SIGUSR1 )) abort();
+    if ((pending & MSYNC_DEFER_INT) && raise( SIGINT )) abort();
+    if (pthread_sigmask( SIG_SETMASK, &previous, NULL )) abort();
+    errno = saved_errno;
