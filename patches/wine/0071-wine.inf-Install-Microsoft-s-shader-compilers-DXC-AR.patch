From 7b812a411130545f68def930ed209df260a2be81 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sat, 24 Oct 2026 09:43:14 -0600
Subject: [PATCH] wine.inf: Install Microsoft's shader compilers (DXC, ARM64
 d3dcompiler_47) into prefixes.

---
 loader/wine.inf.in | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index 5acc022f96c..81350a5eca8 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -102,8 +102,10 @@ AddReg=\
 [DefaultInstall.ntarm64]
 Needs=BaseInstall
 WineFakeDlls=FakeDllsWin64
+CopyFiles=ShaderCompilers.ntarm64
 AddReg=\
     CurrentVersionWow64.ntarm64,\
+    ShaderCompilerOverrides,\
     VCRuntime.ntamd64,\
     VCRuntime.ntarm64,\
     VersionInfo
@@ -123,6 +125,7 @@ AddReg=\
 
 [Wow64Install.ntx86]
 Needs=BaseWow64Install
+CopyFiles=ShaderCompilers.ntx86
 AddReg=\
     CurrentVersionWow64.ntx86,\
     VCRuntime.ntamd64,\
@@ -1293,6 +1296,21 @@ courbi.ttf,,,0x10
 tahoma.ttf,,,0x10
 tahomabd.ttf,,,0x10
 
+; MetalSharp: Microsoft's shader compilers (scripts/stage-shader-compilers.sh), for programs that compile
+; HLSL at run time: DXC, and an ARM64 d3dcompiler_47 in place of Wine's, whose vkd3d-shader miscompiles some
+; shaders. 32-bit programs keep Wine's d3dcompiler_47, which the override falls back to
+[ShaderCompilers.ntarm64]
+d3dcompiler_47.dll
+dxcompiler.dll
+dxil.dll
+
+[ShaderCompilers.ntx86]
+dxcompiler.dll
+dxil.dll
+
+[ShaderCompilerOverrides]
+HKCU,Software\Wine\DllOverrides,"d3dcompiler_47",,"native,builtin"
+
 [InfFiles]
 input.inf,"@%12%\hidclass.sys,-1"
 mouhid.inf,"@%12%\mouhid.sys,-1"
@@ -1396,12 +1414,16 @@ windows.ui.xaml.winmd
 
 [WineSourceDirs]
 FontFiles = fonts
+ShaderCompilers.ntarm64 = shadercompilers\arm64
+ShaderCompilers.ntx86 = shadercompilers\x86
 NlsFiles  = nls
 SortFiles = nls
 WinmdFiles = winmd,include
 
 [DestinationDirs]
 FontFiles = 20
+ShaderCompilers.ntarm64 = 11
+ShaderCompilers.ntx86 = 11
 ColorFiles = 23
 EtcFiles  = 12,etc
 InfFiles  = 17
-- 
