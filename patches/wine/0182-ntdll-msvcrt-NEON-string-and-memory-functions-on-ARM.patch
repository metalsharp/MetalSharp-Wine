 WINE_DEFAULT_DEBUG_CHANNEL(msvcrt);
 
@@ -1564,9 +1565,13 @@ int CDECL _atoldbl(_LDOUBLE *value, char *str)
  */
 size_t __cdecl strlen(const char *str)
 {
