From 9755f65c5b4a1fe15bb1c15f5c6e391e2141747d Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Thu, 22 Oct 2026 07:00:31 -0600
Subject: [PATCH 16/59] ntdll: Skip occupied regions when searching for free
 memory on macOS.

try_map_free_area() probed occupied space one allocation granule at a time with
a mach_vm_map() call per step. Once the reserved areas are used up (the x64
emulator reserves ~1GB of address space per thread), creating a thread took
seconds and thread pools stalled. Use mach_vm_region() to step over the whole
region in the way.
---
 dlls/ntdll/unix/virtual.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index bc31308fd87..1d9ef3a0651 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -1316,6 +1316,29 @@ static void* try_map_free_area( void *base, void *end, ptrdiff_t step,
             (step < 0 && (char *)start - (char *)base < -step) ||
             step == 0)
             break;
+#ifdef __APPLE__
+        {
+            /* skip the whole region in the way instead of probing it one step at a time */
+            mach_vm_address_t region = (mach_vm_address_t)start;
+            mach_vm_size_t region_size;
+            vm_region_basic_info_data_64_t info;
+            mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+            mach_port_t object = MACH_PORT_NULL;
+            size_t align = step > 0 ? step : -step;
+
+            if (!mach_vm_region( mach_task_self(), &region, &region_size, VM_REGION_BASIC_INFO_64,
+                                 (vm_region_info_t)&info, &count, &object ) &&
+                region < (mach_vm_address_t)start + size)
+            {
+                if (step > 0)
+                    start = (void *)(((UINT_PTR)region + region_size + align - 1) & ~(align - 1));
+                else if (region >= (mach_vm_address_t)base + size)
+                    start = (void *)(((UINT_PTR)region - size) & ~(align - 1));
+                else break;
+                continue;
+            }
+        }
+#endif
         start = (char *)start + step;
     }
 
