 static BOOL write_file( const char *path, const char *data, size_t size )
 {
     char tmp[PATH_MAX];
@@ -391,6 +563,48 @@ done:
     return ret;
 }
 
+/* Remedy's Northlight engine (Control): <game folder>/renderer.ini, a JSON rend::UserRendererSettings. The output
+ * resolution is the fullscreen one (windowed sizes are m_iLastWindowSize); the render resolution follows it where
+ * it was the output's or would be larger than the new one. */
+static BOOL fit_remedy( const char *dir, const struct main_display *display, const char *record )
+{
+    char path[PATH_MAX], *text;
+    unsigned int width, height, render_width = 0, render_height = 0;
+    size_t size;
+    BOOL ret = FALSE;
+
+    if (snprintf( path, sizeof(path), "%s/renderer.ini", dir ) >= sizeof(path)) return FALSE;
+    if (!(text = read_file( path, &size ))) return FALSE;
+    if (strstr( text, "\"rend::UserRendererSettings\"" ) &&
+        get_number( text, "\"m_iOutputResolutionX\": ", &width ) &&
+        get_number( text, "\"m_iOutputResolutionY\": ", &height ) && needs_reset( display, record, width, height ))
+    {
+        get_number( text, "\"m_iRenderResolutionX\": ", &render_width );
+        get_number( text, "\"m_iRenderResolutionY\": ", &render_height );
+        text = replace_number( text, &size, "\"m_iOutputResolutionX\": ", ',', display->width );
+        text = replace_number( text, &size, "\"m_iOutputResolutionY\": ", ',', display->height );
+        if ((render_width == width && render_height == height) || render_width > display->width ||
+            render_height > display->height)
+        {
+            text = replace_number( text, &size, "\"m_iRenderResolutionX\": ", ',', display->width );
+            text = replace_number( text, &size, "\"m_iRenderResolutionY\": ", ',', display->height );
+        }
+        if ((ret = write_file( path, text, size )))
+            MESSAGE( "MetalSharp: the saved resolution %ux%u in %s is now %ux%u\n", width, height, path,
+                     display->width, display->height );
+    }
+    free( text );
+    return ret;
+}
+
+static BOOL is_remedy_folder( const char *dir )
+{
+    char path[PATH_MAX];
+    struct stat st;
+
+    return snprintf( path, sizeof(path), "%s/renderer.ini", dir ) < sizeof(path) && !stat( path, &st );
+}
+
 static BOOL is_elden_ring_folder( const char *dir )
 {
     char path[PATH_MAX];
@@ -409,7 +623,7 @@ static BOOL is_game_folder( const char *dir, const char *exe )
     if (dot && snprintf( path, sizeof(path), "%.*s_Data/app.info", (int)(dot - exe), exe ) < sizeof(path) &&
         !stat( path, &st ))
         return TRUE;
-    return is_elden_ring_folder( dir );
+    return is_elden_ring_folder( dir ) || is_remedy_folder( dir );
 }
 
 void fit_saved_resolution( const char *exe, const char *appdata, const char *localappdata )
@@ -423,13 +637,24 @@ void fit_saved_resolution( const char *exe, const char *appdata, const char *loc
     if (!slash || slash - exe >= sizeof(dir)) return;
     memcpy( dir, exe, slash - exe );
     dir[slash - exe] = 0;
+    init_metalfx_scale( exe );
     if (!is_game_folder( dir, exe ) || !get_main_display( &display )) return;
+    if (metalfx_scale > 1.0)
+    {
+        display.full_width = display.width;
+        display.full_height = display.height;
+        if (!ntdll_metalfx_size( display.full_width, display.full_height, &display.width, &display.height ))
+        {
+            display.width = display.full_width;
+            display.height = display.full_height;
+        }
+    }
     if (snprintf( record_path, sizeof(record_path), "%s/.metalsharp/main-display", dir ) >= sizeof(record_path))
         return;
     record = read_file( record_path, &size );
 
     if (!fit_unity( exe, &display, record ) && !fit_unreal( exe, localappdata, &display, record ) &&
-        is_elden_ring_folder( dir ))
+        !fit_remedy( dir, &display, record ) && is_elden_ring_folder( dir ))
         fit_elden_ring( appdata, &display, record );
 
     len = snprintf( line, sizeof(line), "%s %ux%u\n", display.id, display.width, display.height );
@@ -448,6 +673,7 @@ void fit_saved_resolution( const char *exe, const char *appdata, const char *loc
 
 void fit_saved_resolution( const char *exe, const char *appdata, const char *localappdata )
 {
+    init_metalfx_scale( exe );
 }
 
 #endif
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 7095e41a96f..435fc8ce6a3 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -543,6 +543,70 @@ static BOOL read_source_mode( HKEY hkey, UINT index, DEVMODEW *mode )
     return TRUE;
 }
 
+/* MetalSharp: a game Mullion upscales with MetalFX sees the primary display divided by the upscale factor, so it
+ * renders at the size that upscales to the display (ntdll saved_resolution.c). The display's own mode stays the
+ * physical one, and Wine scales the game's windows to it as for an emulated mode change. Only this process sees it. */
+static BOOL metalfx_scaled_size( const struct source *source, UINT *width, UINT *height )
+{
+    if (is_virtual_desktop() || !(source->state_flags & DISPLAY_DEVICE_PRIMARY_DEVICE) ||
+        !(source->state_flags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP))
+        return FALSE;
+    return ntdll_metalfx_size( source->physical.dmPelsWidth, source->physical.dmPelsHeight, width, height );
+}
+
+/* a mode of the physical display's size becomes the scaled display's */
+static void metalfx_scale_mode( const struct source *source, DEVMODEW *mode )
+{
+    UINT width, height;
+
+    if (mode->dmPelsWidth != source->physical.dmPelsWidth || mode->dmPelsHeight != source->physical.dmPelsHeight ||
+        !metalfx_scaled_size( source, &width, &height ))
+        return;
+    mode->dmPelsWidth = width;
+    mode->dmPelsHeight = height;
+}
+
+static int mode_compare(const void *p1, const void *p2);
+
+/* the current mode, unless the game set one, and the modes up to the scaled display's size */
+static void metalfx_scale_source( struct source *source )
+{
+    UINT width, height, count = 0, i, j;
+    DEVMODEW *modes;
+
+    if (source->current.dmPelsWidth != source->physical.dmPelsWidth ||
+        source->current.dmPelsHeight != source->physical.dmPelsHeight ||
+        !metalfx_scaled_size( source, &width, &height ) || !source->modes)
+        return;
+    if (!(modes = calloc( 2 * source->mode_count + 2, sizeof(*modes) ))) return;
+    for (i = 0; i < source->mode_count; i++)
+    {
+        DEVMODEW mode = source->modes[i];
+
+        if (mode.dmPelsWidth == source->physical.dmPelsWidth && mode.dmPelsHeight == source->physical.dmPelsHeight)
+        {
+            mode.dmPelsWidth = width;
+            mode.dmPelsHeight = height;
+        }
+        else if (mode.dmPelsWidth > width || mode.dmPelsHeight > height) continue;
+        for (j = 0; j < count; j++) if (!mode_compare( &modes[j], &mode )) break;
+        if (j == count) modes[count++] = mode;
+    }
+    if (!count)
+    {
+        free( modes );
+        return;
+    }
+    qsort( modes, count, sizeof(*modes), mode_compare );
+    free( source->modes );
+    source->modes = modes;
+    source->mode_count = count;
+    source->current.dmPelsWidth = width;
+    source->current.dmPelsHeight = height;
+    TRACE( "MetalFX: primary display %ux%u shown as %ux%u\n", (UINT)source->physical.dmPelsWidth,
+           (UINT)source->physical.dmPelsHeight, width, height );
+}
+
 static BOOL source_get_registry_settings( const struct source *source, DEVMODEW *mode )
 {
     BOOL ret = FALSE;
@@ -559,6 +623,7 @@ static BOOL source_get_registry_settings( const struct source *source, DEVMODEW
     }
 
     release_display_device_init_mutex( mutex );
+    if (ret) metalfx_scale_mode( source, mode );
     return ret;
 }
 
@@ -739,6 +804,7 @@ static BOOL read_source_from_registry( unsigned int index, struct source *source
     source->physical = source->current;
     if (read_source_mode( hkey, WINE_ENUM_PHYSICAL_SETTINGS, &source->physical ))
         source->physical.dmSize = sizeof(source->physical);
+    metalfx_scale_source( source );
 
     /* DeviceID */
     size = query_reg_ascii_value( hkey, "GPUID", value, sizeof(buffer) );
@@ -6083,6 +6149,8 @@ void sysparams_init(void)
         decorated_mode = IS_OPTION_TRUE( buffer[0] );
     if (!get_config_key( hkey, appkey, "EmulateModeset", buffer, sizeof(buffer) ))
         emulate_modeset = IS_OPTION_TRUE( buffer[0] );
+    /* MetalSharp: a game shown a display divided by its MetalFX factor changes modes as emulated ones */
+    if (ntdll_get_metalfx_scale() > 1.0) emulate_modeset = TRUE;
 
 #undef IS_OPTION_TRUE
 
