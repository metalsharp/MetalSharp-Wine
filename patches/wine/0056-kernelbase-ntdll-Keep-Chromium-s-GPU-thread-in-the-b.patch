From f73af7a723116d80b94d852cf58dde2587c0b55f Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Thu, 22 Oct 2026 20:56:26 -0600
Subject: [PATCH] kernelbase, ntdll: Keep Chromium's GPU thread in the browser
 process on macOS.

A CEF, Chrome or Edge/WebView2 browser process (libcef.dll, chrome_elf.dll or
msedge_elf.dll next to its exe) gets --in-process-gpu: the separate GPU process
can't draw into the browser's windows here, which stay blank. The launcher-specific
rules still take precedence; child processes (--type=) are left alone.
---
 dlls/kernelbase/launchers.c | 28 ++++++++++++++++++++
 dlls/ntdll/unix/env.c       | 51 +++++++++++++++++++++++++++++++++++++
 2 files changed, 79 insertions(+)

diff --git a/dlls/kernelbase/launchers.c b/dlls/kernelbase/launchers.c
index f7b62e68fe8..b0fb40dec12 100644
--- a/dlls/kernelbase/launchers.c
+++ b/dlls/kernelbase/launchers.c
@@ -10,6 +10,7 @@
  */
 
 #include <stdarg.h>
+#include <string.h>
 
 #include "windef.h"
 #include "winbase.h"
@@ -111,6 +112,27 @@ static BOOL process_matches( const WCHAR *app_name, const WCHAR *cmd_line,
               string_contains_ci( cmd_line, policy->path_alt ))));
 }
 
+/* MetalSharp: a Chromium browser (CEF, Chrome, Edge/WebView2) has one of these next to its exe */
+static BOOL is_chromium_browser( const WCHAR *app_name )
+{
+    static const WCHAR *const markers[] = { L"libcef.dll", L"chrome_elf.dll", L"msedge_elf.dll" };
+    const WCHAR *name = app_name, *p;
+    WCHAR path[MAX_PATH];
+    unsigned int i, dir_len;
+
+    if (!app_name) return FALSE;
+    for (p = app_name; *p; p++) if (*p == '\\' || *p == '/') name = p + 1;
+    dir_len = name - app_name;
+    for (i = 0; i < ARRAY_SIZE(markers); i++)
+    {
+        if (dir_len + lstrlenW( markers[i] ) >= MAX_PATH) continue;
+        memcpy( path, app_name, dir_len * sizeof(WCHAR) );
+        lstrcpyW( path + dir_len, markers[i] );
+        if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES) return TRUE;
+    }
+    return FALSE;
+}
+
 const WCHAR *get_launcher_process_args( const WCHAR *app_name, const WCHAR *cmd_line )
 {
     unsigned int i, j;
@@ -129,5 +151,11 @@ const WCHAR *get_launcher_process_args( const WCHAR *app_name, const WCHAR *cmd_
             if (string_contains_ci( cmd_line, policy->blocked_args[j] )) return NULL;
         return policy->append_args;
     }
+
+    /* MetalSharp: any other Chromium browser process. Its GPU process can't draw into the
+     * browser's windows on macOS (they stay blank), so keep the GPU thread in process. */
+    if (!string_contains_ci( cmd_line, L"--type=" ) && !string_contains_ci( cmd_line, L"--in-process-gpu" ) &&
+        is_chromium_browser( app_name ))
+        return L" --in-process-gpu";
     return NULL;
 }
diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index bd888b9928b..6bc829174ac 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1874,6 +1874,54 @@ static void init_peb( RTL_USER_PROCESS_PARAMETERS *params, BOOL debugged )
  *
  * Build process parameters from scratch, for processes without a parent.
  */
+#ifdef __APPLE__
+static BOOL wide_starts_with_ascii( const WCHAR *str, const char *prefix )
+{
+    while (*prefix) if (*str++ != (unsigned char)*prefix++) return FALSE;
+    return TRUE;
+}
+
+/* MetalSharp: Chromium's GPU process (CEF, Chrome, Edge/WebView2) can't draw into the browser
+ * process's windows on macOS, which leaves them blank, so a Chromium browser process started
+ * directly gets --in-process-gpu. kernelbase does the same for one started by CreateProcess. */
+static WCHAR **chromium_in_process_gpu( WCHAR **wargv )
+{
+    static const char *const markers[] = { "libcef.dll", "chrome_elf.dll", "msedge_elf.dll" };
+    static const char flag[] = "--in-process-gpu";
+    const WCHAR *name = wargv[0], *p;
+    WCHAR path[MAX_PATH], **ret;
+    unsigned int argc, i, j, dir_len;
+    char *unix_name;
+    BOOL found = FALSE;
+
+    for (argc = 1; wargv[argc]; argc++)
+        if (wide_starts_with_ascii( wargv[argc], "--type=" ) || wide_starts_with_ascii( wargv[argc], flag ))
+            return wargv;
+    for (p = wargv[0]; *p; p++) if (*p == '\\' || *p == '/') name = p + 1;
+    dir_len = name - wargv[0];
+    for (i = 0; i < ARRAY_SIZE(markers) && !found; i++)
+    {
+        if (dir_len + strlen( markers[i] ) >= MAX_PATH) continue;
+        memcpy( path, wargv[0], dir_len * sizeof(WCHAR) );
+        for (j = 0; markers[i][j]; j++) path[dir_len + j] = (unsigned char)markers[i][j];
+        path[dir_len + j] = 0;
+        if (ntdll_get_unix_file_name( path, &unix_name, FILE_OPEN )) continue;
+        free( unix_name );
+        found = TRUE;
+    }
+    if (!found) return wargv;
+
+    /* the old array stays allocated: its strings are still referenced */
+    if (!(ret = malloc( (argc + 2) * sizeof(*ret) + sizeof(flag) * sizeof(WCHAR) ))) return wargv;
+    memcpy( ret, wargv, argc * sizeof(*ret) );
+    ret[argc] = (WCHAR *)(ret + argc + 2);
+    for (j = 0; j < sizeof(flag); j++) ret[argc][j] = (unsigned char)flag[j];
+    ret[argc + 1] = NULL;
+    TRACE( "Chromium browser %s: adding %s\n", debugstr_w(wargv[0]), flag );
+    return ret;
+}
+#endif
+
 static RTL_USER_PROCESS_PARAMETERS *build_initial_params(void)
 {
     static const WCHAR valueW[] = {'1',0};
@@ -1948,6 +1996,9 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params(void)
     virtual_alloc_first_teb();
 
     main_wargv = build_wargv( get_dos_path( nt_name.Buffer ));
+#ifdef __APPLE__
+    main_wargv = chromium_in_process_gpu( main_wargv );
+#endif
     cmdline = build_command_line( main_wargv );
 
     TRACE( "image %s cmdline %s dir %s\n",
-- 
