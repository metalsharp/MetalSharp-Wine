From 230ada0408bcf0a5ad7a3fee323d31df56ebf743 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Tue, 10 Nov 2026 23:04:43 -0700
Subject: [PATCH 144/158] ntdll: Report a path through a file as a missing path
 on case-insensitive volumes.

Opening C:\dir\file.exe\name returned STATUS_OBJECT_NAME_NOT_FOUND on
macOS, where Windows, and Wine on a case-sensitive file system, return
STATUS_OBJECT_PATH_NOT_FOUND: the search that reports ENOTDIR is only
made when names have to be matched without regard to case.

Fixes 2 failures in ntdll:file and 4 in ntdll:path.
---
 dlls/ntdll/unix/file.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index f9e1bed43ae..3bc9f50c9d0 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2696,6 +2696,14 @@ static NTSTATUS find_file_in_dir( int root_fd, char *unix_name, int pos, const W
     {
         unix_name[pos + ret] = 0;
         if (!fstatat( root_fd, unix_name, &st, 0 )) return STATUS_SUCCESS;
+        /* The "directory" is a file. On a case-sensitive file system the search below opens it and fails the
+         * same way; on a case-insensitive one (macOS) nothing is searched, and the name was reported as not
+         * found where Windows reports the path. */
+        if (errno == ENOTDIR)
+        {
+            unix_name[pos - 1] = 0;
+            return STATUS_OBJECT_PATH_NOT_FOUND;
+        }
     }
     if (check_case) goto not_found;  /* we want an exact match */
 
