From 9dd65e222d29f4cd63174a1b7b2dcdaeac8db22a Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sat, 21 Nov 2026 12:51:09 -0700
Subject: [PATCH] kernelbase, ntdll: Battle.net's browser composites in
 software.

On 8.0 Battle.net's login window and its main window stayed black on a
fresh install, every time (metalsharp/MetalSharp-Wine#50): its pages loaded
(the login page answered 200), but with --in-process-gpu alone Chromium
composited them on the GPU, and what it composited never reached the window.
Only the client's own Qt chrome (the title bar, the settings button) drew.

Battle.net.exe now gets --in-process-gpu --disable-gpu-compositing: the GPU
stays in process and keeps WebGL, and the pages composite in software, as
the x86_64 build's MetalSharp starts it. Tested with Battle.net 2.53.8.17986
on Mullion: the login window draws, logging in works, and Home, Games and
Shop draw, on every start.

kernelbase gives it to Battle.net.exe started by another program (its
Launcher), now unless the command line has --disable-gpu-compositing, so a
client that restarts itself with --in-process-gpu still gets it; ntdll gives
the same to Battle.net.exe started directly, which before got nothing. The
rest of Battle.net's folder (the Launcher, the Agent) is left alone.
---
 dlls/kernelbase/launchers.c | 18 +++++++++++----
 dlls/ntdll/unix/env.c       | 46 +++++++++++++++++++++++++++----------
 2 files changed, 47 insertions(+), 17 deletions(-)

diff --git a/dlls/kernelbase/launchers.c b/dlls/kernelbase/launchers.c
index 392d079..39deded 100644
--- a/dlls/kernelbase/launchers.c
+++ b/dlls/kernelbase/launchers.c
@@ -43,6 +43,14 @@ struct launcher_process_policy
 /* A command line that already has them. */
 #define CHROMIUM_SOFTWARE_MARKER L"--use-angle=swiftshader-webgl"
 
+/* MetalSharp: what Battle.net's browser (Battle.net.exe) gets: the GPU in process, and compositing in software. With
+ * GPU compositing its login window and its main window stayed black: the browser drew its pages, but what the GPU
+ * composited never reached the window. WebGL keeps the GPU. ntdll gives the same to Battle.net.exe started directly
+ * (env.c, battlenet_args). */
+#define BATTLENET_ARGS L" --in-process-gpu --disable-gpu-compositing"
+/* A command line that already has them. */
+#define BATTLENET_MARKER L"--disable-gpu-compositing"
+
 static const struct launcher_process_policy launcher_process_policies[] =
 {
     /* WineForge-Internal: launcher-compat/steam-cef-swiftshader-v1. Every web helper process, as MetalSharp's x86_64
@@ -76,17 +84,17 @@ static const struct launcher_process_policy launcher_process_policies[] =
         {L"--type=", CHROMIUM_SOFTWARE_MARKER, NULL},
         CHROMIUM_SOFTWARE_ARGS,
     },
-    /* WineForge-Internal: launcher-compat/battlenet-in-process-gpu-v1. MetalSharp: the GPU in process alone, as before
-     * 7.0. Given CHROMIUM_SOFTWARE_ARGS, Battle.net no longer loaded, with an exception in winevulkan's vkCreateBuffer
-     * (metalsharp/MetalSharp-Wine#50). */
+    /* WineForge-Internal: launcher-compat/battlenet-in-process-gpu-v1. MetalSharp: the GPU in process, as before 7.0
+     * (given CHROMIUM_SOFTWARE_ARGS, Battle.net no longer loaded, with an exception in winevulkan's vkCreateBuffer), and
+     * composited in software (BATTLENET_ARGS, metalsharp/MetalSharp-Wine#50). */
     {
         L"Battle.net.exe",
         L"\\Program Files (x86)\\Battle.net\\",
         L"/Program Files (x86)/Battle.net/",
         NULL,
         NULL,
-        {L"--type=", L"--in-process-gpu", NULL},
-        L" --in-process-gpu",
+        {L"--type=", BATTLENET_MARKER, NULL},
+        BATTLENET_ARGS,
     },
     /* WineForge-Internal: launcher-compat/ubisoft-connect-in-process-gpu-v1. Its browser is upc.exe itself; its
      * renderers (UplayWebCore.exe --type=...) are left as they are. */
diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index 9f55bda..b67f6e8 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -2482,21 +2482,34 @@ static BOOL wide_starts_with_ascii( const WCHAR *str, const char *prefix )
     return TRUE;
 }
 
+/* A file name (its last path element) as ASCII, compared without case */
+static BOOL wide_name_is_ascii( const WCHAR *str, const char *name )
+{
+    while (*name) if (ntdll_towlower( *str++ ) != ntdll_towlower( (unsigned char)*name++ )) return FALSE;
+    return !*str;
+}
+
 /* MetalSharp: a Chromium browser (CEF, Chrome, Edge/WebView2) started directly gets what kernelbase gives one started
  * by CreateProcess (launchers.c, CHROMIUM_SOFTWARE_ARGS): no sandbox, the GPU in process and off, and SwiftShader for
- * WebGL only, so its UI composites in software. Drawn through ANGLE into its windows, it stops updating under FEX. */
+ * WebGL only, so its UI composites in software. Drawn through ANGLE into its windows, it stops updating under FEX.
+ * Battle.net's browser gets what kernelbase gives it instead (launchers.c, BATTLENET_ARGS): the GPU in process, and
+ * compositing in software, without which its login and main windows stayed black (metalsharp/MetalSharp-Wine#50);
+ * the rest of Battle.net's folder (its Launcher, which starts the browser through kernelbase) is left alone. */
 static WCHAR **chromium_software_drawing( WCHAR **wargv )
 {
     static const char *const markers[] = { "libcef.dll", "chrome_elf.dll", "msedge_elf.dll" };
-    static const char *const flags[] = { "--no-sandbox", "--in-process-gpu", "--disable-gpu", "--disable-d3d11",
-                                         "--enable-unsafe-swiftshader", "--use-gl=angle",
-                                         "--use-angle=swiftshader-webgl" };
+    static const char *const software_flags[] = { "--no-sandbox", "--in-process-gpu", "--disable-gpu",
+                                                  "--disable-d3d11", "--enable-unsafe-swiftshader", "--use-gl=angle",
+                                                  "--use-angle=swiftshader-webgl" };
+    static const char *const battlenet_flags[] = { "--in-process-gpu", "--disable-gpu-compositing" };
+    const char *const *flags = software_flags;
+    unsigned int flag_count = ARRAY_SIZE(software_flags);
     const WCHAR *name = wargv[0], *p;
     WCHAR path[MAX_PATH], **ret, *text;
     unsigned int argc, i, j, dir_len;
     size_t chars = 0;
     char *unix_name;
-    BOOL found = FALSE;
+    BOOL found = FALSE, battlenet = FALSE;
 
     for (argc = 1; wargv[argc]; argc++)
         if (wide_starts_with_ascii( wargv[argc], "--type=" ) ||
@@ -2505,10 +2518,19 @@ static WCHAR **chromium_software_drawing( WCHAR **wargv )
     for (p = wargv[0]; *p; p++)
     {
         if (*p == '\\' || *p == '/') name = p + 1;
-        /* Battle.net gets the GPU in process alone, from kernelbase (launchers.c) */
         if (wide_starts_with_ascii( p, "Battle.net" ) && p > wargv[0] && (p[-1] == '\\' || p[-1] == '/') &&
             (p[10] == '\\' || p[10] == '/'))
-            return wargv;
+            battlenet = TRUE;
+    }
+    if (battlenet)
+    {
+        if (!wide_name_is_ascii( name, "Battle.net.exe" )) return wargv;
+        /* a command line that already has them */
+        for (i = 1; i < argc; i++)
+            if (wide_starts_with_ascii( wargv[i], "--disable-gpu-compositing" )) return wargv;
+        flags = battlenet_flags;
+        flag_count = ARRAY_SIZE(battlenet_flags);
+        found = TRUE;
     }
     dir_len = name - wargv[0];
     for (i = 0; i < ARRAY_SIZE(markers) && !found; i++)
@@ -2523,18 +2545,18 @@ static WCHAR **chromium_software_drawing( WCHAR **wargv )
     }
     if (!found) return wargv;
 
-    for (i = 0; i < ARRAY_SIZE(flags); i++) chars += strlen( flags[i] ) + 1;
+    for (i = 0; i < flag_count; i++) chars += strlen( flags[i] ) + 1;
     /* the old array stays allocated: its strings are still referenced */
-    if (!(ret = malloc( (argc + ARRAY_SIZE(flags) + 1) * sizeof(*ret) + chars * sizeof(WCHAR) ))) return wargv;
+    if (!(ret = malloc( (argc + flag_count + 1) * sizeof(*ret) + chars * sizeof(WCHAR) ))) return wargv;
     memcpy( ret, wargv, argc * sizeof(*ret) );
-    text = (WCHAR *)(ret + argc + ARRAY_SIZE(flags) + 1);
-    for (i = 0; i < ARRAY_SIZE(flags); i++)
+    text = (WCHAR *)(ret + argc + flag_count + 1);
+    for (i = 0; i < flag_count; i++)
     {
         ret[argc + i] = text;
         for (j = 0; flags[i][j]; j++) *text++ = (unsigned char)flags[i][j];
         *text++ = 0;
     }
-    ret[argc + ARRAY_SIZE(flags)] = NULL;
+    ret[argc + flag_count] = NULL;
     TRACE( "Chromium browser %s: drawing in software\n", debugstr_w(wargv[0]) );
     return ret;
 }
-- 
2.54.0 (Apple Git-157)

