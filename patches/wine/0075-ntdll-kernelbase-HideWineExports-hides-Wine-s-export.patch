From c69cba1515a138af1d39f55d1e1f04a8d713763d Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sat, 24 Oct 2026 23:16:20 -0600
Subject: [PATCH] ntdll, kernelbase: HideWineExports hides Wine's exports and
 registry keys from programs that refuse to run under Wine

With HideWineExports set (HKCU\Software\Wine or AppDefaults\<app>.exe), GetProcAddress() and
LdrGetProcedureAddress() don't find the user-visible wine_* exports of ntdll and kernel32, and
RegOpenKeyEx() doesn't find HKCU/HKLM Software\Wine. The PlayStation PC SDK in Sony's ports checks
all of these. The __wine_* exports stay visible for FEX and Wine's own modules, and ntdll gains
metalsharp_get_version() and metalsharp_server_handle_to_fd() aliases for MetalSharp's components.
---
 dlls/kernelbase/registry.c | 33 ++++++++++++++-
 dlls/ntdll/loader.c        | 82 ++++++++++++++++++++++++++++++++++++++
 dlls/ntdll/ntdll.spec      |  4 ++
 3 files changed, 117 insertions(+), 2 deletions(-)

diff --git a/dlls/kernelbase/registry.c b/dlls/kernelbase/registry.c
index 7ec30c2ca7f..b9553ea80e0 100644
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -636,6 +636,32 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegCreateKeyExA( HKEY hkey, LPCSTR name, DWORD
 }
 
 
+extern BOOL CDECL __wine_hide_wine_exports(void);
+
+/* With HideWineExports (see LdrGetProcedureAddress()), programs don't find Wine's own registry keys either: the
+ * PlayStation PC SDK quits on HKLM\Software\Wine\Ports. Wine's components read their settings with NtOpenKey(). */
+static BOOL is_hidden_wine_key( HKEY root, const UNICODE_STRING *name )
+{
+    static const WCHAR * const prefixes[] = { L"Software\\Wine", L"Software\\Wow6432Node\\Wine" };
+    unsigned int i;
+    USHORT len;
+
+    if (HandleToUlong(root) != HandleToUlong(HKEY_CURRENT_USER) &&
+        HandleToUlong(root) != HandleToUlong(HKEY_LOCAL_MACHINE)) return FALSE;
+    if (!name->Length || !__wine_hide_wine_exports()) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(prefixes); i++)
+    {
+        len = wcslen( prefixes[i] ) * sizeof(WCHAR);
+        if (name->Length < len || wcsnicmp( name->Buffer, prefixes[i], len / sizeof(WCHAR) )) continue;
+        if (name->Length == len || name->Buffer[len / sizeof(WCHAR)] == '\\')
+        {
+            TRACE( "hiding %s\n", debugstr_wn(name->Buffer, name->Length / sizeof(WCHAR)) );
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
 /******************************************************************************
  * RegOpenKeyExW   (kernelbase.@)
  *
@@ -658,9 +684,9 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegOpenKeyExW( HKEY hkey, LPCWSTR name, DWORD o
 
     if (!retkey) return ERROR_INVALID_PARAMETER;
     *retkey = NULL;
-    if (!(hkey = get_special_root_hkey( hkey ))) return ERROR_INVALID_HANDLE;
-
     RtlInitUnicodeString( &nameW, name );
+    if (is_hidden_wine_key( hkey, &nameW )) return ERROR_FILE_NOT_FOUND;
+    if (!(hkey = get_special_root_hkey( hkey ))) return ERROR_INVALID_HANDLE;
     return RtlNtStatusToDosError( open_key( retkey, hkey, &nameW, options, access, FALSE ) );
 }
 
@@ -689,6 +715,7 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegOpenKeyExA( HKEY hkey, LPCSTR name, DWORD op
 {
     STRING nameA;
     NTSTATUS status;
+    HKEY root;
 
     if (retkey && (!name || !name[0]) &&
         (HandleToUlong(hkey) >= HandleToUlong(HKEY_SPECIAL_ROOT_FIRST)) &&
@@ -705,6 +732,7 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegOpenKeyExA( HKEY hkey, LPCSTR name, DWORD op
         if (HandleToUlong(hkey) == HandleToUlong(HKEY_CLASSES_ROOT) && name && *name == '\\') name++;
     }
 
+    root = hkey;
     if (!(hkey = get_special_root_hkey( hkey ))) return ERROR_INVALID_HANDLE;
 
     RtlInitAnsiString( &nameA, name );
@@ -712,6 +740,7 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegOpenKeyExA( HKEY hkey, LPCSTR name, DWORD op
                                                  &nameA, FALSE )))
     {
         UNICODE_STRING nameW = NtCurrentTeb()->StaticUnicodeString;
+        if (is_hidden_wine_key( root, &nameW )) return ERROR_FILE_NOT_FOUND;
         status = open_key( retkey, hkey, &nameW, options, access, FALSE );
     }
     return RtlNtStatusToDosError( status );
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index ed6cd186e32..91c60f9ca84 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -91,6 +91,7 @@ static const WCHAR system_dir[] = L"C:\\windows\\system32\\";
 static const WCHAR system_path[] = L"C:\\windows\\system32;C:\\windows\\system;C:\\windows";
 
 static BOOL is_prefix_bootstrap;  /* are we bootstrapping the prefix? */
+static BOOL hide_wine_exports;    /* GetProcAddress() doesn't find wine_get_version() and its siblings */
 static BOOL imports_fixup_done = FALSE;  /* set once the imports have been fixed up, before attaching them */
 static BOOL process_detaching = FALSE;  /* set on process detach to avoid deadlocks with thread detach */
 static int free_lib_count;   /* recursion depth of LdrUnloadDll calls */
@@ -2069,6 +2070,27 @@ NTSTATUS WINAPI LdrUnlockLoaderLock( ULONG flags, ULONG_PTR magic )
 }
 
 
+/* Some programs refuse to run when they find the exports that tell Wine apart (the PlayStation PC SDK in Sony's
+ * ports looks for wine_get_version, wine_server_call and wine_get_unix_file_name in ntdll and kernel32), so
+ * HideWineExports makes dynamic lookups miss the user-visible wine_* exports of those two. The __wine_* ones
+ * stay visible: FEX and Wine's own modules look some of them up at run time. MetalSharp's components use the
+ * metalsharp_* aliases of the wine_* functions they need. */
+/***********************************************************************
+ *           __wine_hide_wine_exports   (NTDLL.@)
+ *
+ * Whether HideWineExports is set for this process, for kernelbase to hide Wine's registry keys as well.
+ */
+BOOL CDECL __wine_hide_wine_exports(void)
+{
+    return hide_wine_exports;
+}
+
+static BOOL is_hidden_export( const WINE_MODREF *wm, const char *name )
+{
+    return hide_wine_exports && name && !strncmp( name, "wine_", 5 ) &&
+           (wm->ldr.DdagNode == node_ntdll || wm->ldr.DdagNode == node_kernel32);
+}
+
 /******************************************************************
  *		LdrGetProcedureAddress  (NTDLL.@)
  */
@@ -2085,6 +2107,8 @@ NTSTATUS WINAPI LdrGetProcedureAddress(HMODULE module, const ANSI_STRING *name,
 
     /* check if the module itself is invalid to return the proper error */
     if (!(wm = get_modref( module ))) ret = STATUS_DLL_NOT_FOUND;
+    else if (name && is_hidden_export( wm, name->Buffer ))
+        TRACE( "hiding %s\n", debugstr_a(name->Buffer) );
     else if (name && (wfdx_proc = wfdx_launcher_get_proc( module, name )))
     {
         *address = wfdx_proc;
@@ -4274,6 +4298,63 @@ static void load_global_options(void)
     }
 }
 
+/***********************************************************************
+ *           load_hide_wine_exports
+ */
+static void load_hide_wine_exports(void)
+{
+    static const WCHAR value_name[] = L"HideWineExports";
+    const WCHAR *p, *appname = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    WCHAR app_key[MAX_PATH + 20], buffer[64];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING nameW, valueW;
+    HANDLE root, config_key, hkey;
+    ULONG size;
+    int i;
+
+    RtlOpenCurrentUser( KEY_READ, &root );
+    InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, root, NULL );
+    RtlInitUnicodeString( &nameW, L"Software\\Wine" );
+    if (NtOpenKey( &config_key, KEY_READ, &attr )) config_key = 0;
+    NtClose( root );
+    if (!config_key) return;
+
+    if (appname)
+    {
+        if ((p = wcsrchr( appname, '/' ))) appname = p + 1;
+        if ((p = wcsrchr( appname, '\\' ))) appname = p + 1;
+    }
+    RtlInitUnicodeString( &valueW, value_name );
+    /* @@ Wine registry key: HKCU\Software\Wine\AppDefaults\app.exe, then HKCU\Software\Wine */
+    for (i = appname ? 0 : 1; i < 2; i++)
+    {
+        hkey = config_key;
+        if (!i)
+        {
+            if (wcslen( appname ) >= MAX_PATH) continue;
+            wcscpy( app_key, L"AppDefaults\\" );
+            wcscat( app_key, appname );
+            RtlInitUnicodeString( &nameW, app_key );
+            attr.RootDirectory = config_key;
+            if (NtOpenKey( &hkey, KEY_READ, &attr )) continue;
+        }
+        size = sizeof(buffer) - sizeof(WCHAR);
+        if (!NtQueryValueKey( hkey, &valueW, KeyValuePartialInformation, buffer, size, &size ))
+        {
+            if (info->Type == REG_DWORD && info->DataLength >= sizeof(DWORD))
+                hide_wine_exports = *(DWORD *)info->Data != 0;
+            else if (info->Type == REG_SZ && info->DataLength >= sizeof(WCHAR))
+                hide_wine_exports = wcschr( L"yYtT1", *(WCHAR *)info->Data ) != NULL;
+            if (hkey != config_key) NtClose( hkey );
+            break;
+        }
+        if (hkey != config_key) NtClose( hkey );
+    }
+    NtClose( config_key );
+    if (hide_wine_exports) TRACE( "hiding Wine's version exports from GetProcAddress\n" );
+}
+
 static BOOL needs_elevation(void)
 {
     ACTIVATION_CONTEXT_RUN_LEVEL_INFORMATION run_level;
@@ -4542,6 +4623,7 @@ void loader_init( CONTEXT *context, void **entry )
         init_user_process_params();
         load_global_options();
         version_init();
+        load_hide_wine_exports();
         open_known_dll_ntdir();
 
         default_load_path = peb->ProcessParameters->DllPath.Buffer;
diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
index d2ed8b7dc5d..68c69b0a0ea 100644
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -1790,3 +1790,7 @@
 @ cdecl wine_get_version()
 @ cdecl wine_get_build_id()
 @ cdecl wine_get_host_version(ptr ptr)
+# Never hidden by HideWineExports (loader.c), for MetalSharp's own components (FEX)
+@ cdecl metalsharp_get_version() wine_get_version
+@ cdecl metalsharp_server_handle_to_fd(long long ptr ptr) wine_server_handle_to_fd
+@ cdecl __wine_hide_wine_exports()
-- 
2.54.0 (Apple Git-157)

