From 44f9adf7d263a799a6c9f6067b98e4e9967380f6 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Wed, 25 Nov 2026 23:24:48 -0700
Subject: [PATCH 207/207] ntdll: WFDXCompat's NATIVE_D3D10 launcher flag is 0x10.

WFDXCompat took 0x8 for WFDX_LAUNCHER_FLAG_SERVICE_SWAPCHAIN (WineForge's, for Epic's self-update
service) and moved MetalSharp's NATIVE_D3D10 to 0x10. The companion and this loader ship
together.
---
 dlls/ntdll/wfdxcompat_loader.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/ntdll/wfdxcompat_loader.c b/dlls/ntdll/wfdxcompat_loader.c
index 60830c608e6..3ce48faea1e 100644
--- a/dlls/ntdll/wfdxcompat_loader.c
+++ b/dlls/ntdll/wfdxcompat_loader.c
@@ -39,7 +39,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(module);
 #define WFDX_LAUNCHER_FLAG_INTERPOSE     0x00000001
 #define WFDX_LAUNCHER_FLAG_CONTEXT_STATE 0x00000002
 #define WFDX_LAUNCHER_FLAG_GDI_SURFACE   0x00000004
-#define WFDX_LAUNCHER_FLAG_NATIVE_D3D10  0x00000008
+#define WFDX_LAUNCHER_FLAG_NATIVE_D3D10  0x00000010
 
 /* Mullion implements D3D10 devices, device context state and GDI-compatible surfaces itself,
  * which WineForge's companion emulated for D3DMetal: by default the companion only interposes
