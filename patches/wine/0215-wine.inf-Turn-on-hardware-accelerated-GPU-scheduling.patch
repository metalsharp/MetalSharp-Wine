From 03dcc1f75e9af412fdbbbd5e2791f89a12b1da49 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Fri, 27 Nov 2026 14:25:18 -0700
Subject: [PATCH 215/215] wine.inf: Turn on hardware-accelerated GPU scheduling.

Windows keeps the setting as HwSchMode under
HKLM\System\CurrentControlSet\Control\GraphicsDrivers, 2 when it is on.
D3DKMTQueryAdapterInfo already reports it on (KMTQAITYPE_WDDM_2_7_CAPS),
which is what Streamline reads, but games read the registry value too:
Black Myth: Wukong left DLSS Frame Generation greyed out in its menu, and
said to turn hardware-accelerated GPU scheduling on, while Streamline ran
it. A value already in a prefix is kept.
---
 loader/wine.inf.in | 1 +
 1 file changed, 1 insertion(+)

diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index a351d0b5c99..d5cd6900585 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -637,6 +637,7 @@ HKLM,Software\Policies,,16
 HKLM,Software\Registered Applications,,16
 HKLM,System\CurrentControlSet\Control\Filesystem,"NtfsDisable8dot3NameCreation",0x10003,0
 HKLM,System\CurrentControlSet\Control\Filesystem,"NtfsDisableLastAccessUpdate",0x10003,0x80000002
+HKLM,System\CurrentControlSet\Control\GraphicsDrivers,"HwSchMode",0x10003,2
 HKLM,System\CurrentControlSet\Control\hivelist,,16
 HKLM,System\CurrentControlSet\Control\Lsa,"Security Packages",0x10002,kerberos,schannel
 HKLM,System\CurrentControlSet\Control\Lsa\Kerberos,,16
