index 8b51f023c96..6400d6185e2 100644
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -5626,6 +5626,8 @@ static inline PLIST_ENTRY RemoveTailList(PLIST_ENTRY le)
 
