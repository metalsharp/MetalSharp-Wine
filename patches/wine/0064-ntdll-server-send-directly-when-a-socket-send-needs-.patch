From ede927fc9edd8ea706958c71f03e1a0bdc48f970 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sat, 24 Oct 2026 00:58:04 -0600
Subject: [PATCH 64/66] ntdll, server: send directly when a socket send needs
 no async (one server round trip)

With no event, APC or completion port, the server skips creating an async for a send it
would let complete synchronously; the client sends and only takes the regular path when
the send would block, is partial or fails.
---
 dlls/ntdll/unix/file.c         |  2 +-
 dlls/ntdll/unix/socket.c       | 39 ++++++++++++++++++++++++++--------
 dlls/ntdll/unix/unix_private.h |  1 +
 include/wine/server_protocol.h |  1 +
 server/protocol.def            |  1 +
 server/sock.c                  | 21 ++++++++++++++++++
 6 files changed, 55 insertions(+), 10 deletions(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 8b87cc84b77..3cb07c68c4a 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5391,7 +5391,7 @@ static BOOL async_write_proc( void *user, ULONG_PTR *info, unsigned int *status
     return TRUE;
 }
 
-static void set_sync_iosb( IO_STATUS_BLOCK *io, NTSTATUS status, ULONG_PTR info, unsigned int options )
+void set_sync_iosb( IO_STATUS_BLOCK *io, NTSTATUS status, ULONG_PTR info, unsigned int options )
 {
     if (in_wow64_call() && !(options & (FILE_SYNCHRONOUS_IO_ALERT | FILE_SYNCHRONOUS_IO_NONALERT)))
     {
diff --git a/dlls/ntdll/unix/socket.c b/dlls/ntdll/unix/socket.c
index 9674d0f1238..18ecd6d9c9b 100644
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -1187,20 +1187,41 @@ static NTSTATUS sock_send( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, voi
                            IO_STATUS_BLOCK *io, int fd, struct async_send_ioctl *async, unsigned int server_flags )
 {
     HANDLE wait_handle;
-    BOOL nonblocking;
+    BOOL nonblocking, try_direct;
     unsigned int status;
     ULONG options;
 
-    SERVER_START_REQ( send_socket )
+    /* With no event or APC, ask for a direct send: if it can complete right away the server
+     * creates no async, and a complete send then costs one server round trip instead of two. */
+    try_direct = !event && !apc && !(server_flags & SERVER_SOCKET_IO_FORCE_ASYNC) && !is_icmp_over_dgram( fd );
+
+    for (;;)
     {
-        req->flags = server_flags;
-        req->async  = server_async( handle, &async->io, event, apc, apc_user, iosb_client_ptr(io) );
-        status = wine_server_call( req );
-        wait_handle = wine_server_ptr_handle( reply->wait );
-        options     = reply->options;
-        nonblocking = reply->nonblocking;
+        SERVER_START_REQ( send_socket )
+        {
+            req->flags = server_flags | (try_direct ? SERVER_SOCKET_IO_TRY_DIRECT : 0);
+            req->async  = server_async( handle, &async->io, event, apc, apc_user, iosb_client_ptr(io) );
+            status = wine_server_call( req );
+            wait_handle = wine_server_ptr_handle( reply->wait );
+            options     = reply->options;
+            nonblocking = reply->nonblocking;
+        }
+        SERVER_END_REQ;
+
+        if (status != STATUS_MORE_PROCESSING_REQUIRED) break;
+
+        status = try_send( fd, async );
+        if (status == STATUS_SUCCESS && async->iov_cursor == async->count)
+        {
+            set_sync_iosb( io, status, async->sent_len, options );
+            if (async->fd != -1) close( async->fd );
+            release_fileio( &async->io );
+            return status;
+        }
+        /* Partial, would block or failed: the regular path continues from the iov cursor
+         * and reports the result (and reselects events) as before. */
+        try_direct = FALSE;
     }
-    SERVER_END_REQ;
 
     /* the server currently will never succeed immediately */
     assert(status == STATUS_ALERTED || status == STATUS_PENDING || NT_ERROR(status));
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index b74f89d2308..829cd4459cb 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -439,6 +439,7 @@ extern void init_cpu_info(void);
 extern void init_shared_data_cpuinfo( struct _KUSER_SHARED_DATA *data );
 extern void file_complete_async( HANDLE handle, unsigned int options, HANDLE event, PIO_APC_ROUTINE apc, void *apc_user,
                                  IO_STATUS_BLOCK *io, NTSTATUS status, ULONG_PTR information );
+extern void set_sync_iosb( IO_STATUS_BLOCK *io, NTSTATUS status, ULONG_PTR info, unsigned int options );
 extern void set_async_direct_result( HANDLE *async_handle, unsigned int options, IO_STATUS_BLOCK *io,
                                      NTSTATUS status, ULONG_PTR information, BOOL mark_pending );
 
diff --git a/include/wine/server_protocol.h b/include/wine/server_protocol.h
index 41e739b8404..109b369a4ce 100644
--- a/include/wine/server_protocol.h
+++ b/include/wine/server_protocol.h
@@ -2109,6 +2109,7 @@ struct send_socket_reply
 
 #define SERVER_SOCKET_IO_FORCE_ASYNC 0x01
 #define SERVER_SOCKET_IO_SYSTEM      0x02
+#define SERVER_SOCKET_IO_TRY_DIRECT  0x04  /* send_socket: no async if it can complete synchronously */
 
 
 struct socket_get_events_request
diff --git a/server/protocol.def b/server/protocol.def
index 4da25a79b67..5daecdeb759 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -1778,6 +1778,7 @@ enum server_fd_type
 
 #define SERVER_SOCKET_IO_FORCE_ASYNC 0x01
 #define SERVER_SOCKET_IO_SYSTEM      0x02
+#define SERVER_SOCKET_IO_TRY_DIRECT  0x04  /* send_socket: no async if it can complete synchronously */
 
 /* Get socket event flags */
 @REQ(socket_get_events)
diff --git a/server/sock.c b/server/sock.c
index caa32a32df1..d0a98075ae2 100644
--- a/server/sock.c
+++ b/server/sock.c
@@ -4080,6 +4080,27 @@ DECL_HANDLER(send_socket)
     if (status == STATUS_PENDING && !force_async && sock->nonblocking)
         status = STATUS_DEVICE_NOT_READY;
 
+    /* With no event, APC or completion port, a send that completes right away has nothing to
+     * report through an async: the client sends directly and only comes back (without this flag)
+     * if it can't complete. STATUS_MORE_PROCESSING_REQUIRED tells it no async was created. */
+    if (status == STATUS_ALERTED && (req->flags & SERVER_SOCKET_IO_TRY_DIRECT) &&
+        !req->async.event && !req->async.apc)
+    {
+        apc_param_t comp_key;
+        struct completion *completion = fd_get_completion( fd, &comp_key );
+
+        if (!completion)
+        {
+            reply->wait = 0;
+            reply->options = get_fd_options( fd );
+            reply->nonblocking = sock->nonblocking;
+            set_error( STATUS_MORE_PROCESSING_REQUIRED );
+            release_object( sock );
+            return;
+        }
+        release_object( completion );
+    }
+
     if ((async = create_request_async( fd, &req->async, req->flags & SERVER_SOCKET_IO_SYSTEM )))
     {
         struct send_req *send_req;
-- 
