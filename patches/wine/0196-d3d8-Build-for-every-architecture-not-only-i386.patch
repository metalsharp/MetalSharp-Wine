From a29c11c7a1d2fe680866ce8f8250e29a22364a02 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sun, 22 Nov 2026 20:33:27 -0700
Subject: [PATCH] d3d8: Build for every architecture, not only i386.

MetalSharp: a 64-bit program could not load d3d8.dll. Wine builds d3d8
for i386 only, so wineboot put no 64-bit d3d8.dll in System32, and the
loader, which gives the DXVK and VKD3D lanes DXVK's d3d8.dll in place of
a builtin, only does so for a builtin the prefix has. LoadLibrary failed
on every lane. 64-bit Windows has a 64-bit d3d8.dll, and DXVK builds one
(ARM64X here, for x86_64 programs under FEX).

d3d8 is now built for aarch64 and arm64ec too, an ARM64X builtin as the
other Direct3D DLLs are: the DXVK and VKD3D lanes get DXVK's, and the
Wine lane gets Wine's on wined3d.
---
 dlls/d3d8/Makefile.in | 1 -
 1 file changed, 1 deletion(-)

diff --git a/dlls/d3d8/Makefile.in b/dlls/d3d8/Makefile.in
index b3dcabffb15..55717eb9129 100644
--- a/dlls/d3d8/Makefile.in
+++ b/dlls/d3d8/Makefile.in
@@ -1,7 +1,6 @@
 MODULE    = d3d8.dll
 IMPORTLIB = d3d8
 IMPORTS   = dxguid uuid wined3d
-ENABLE_ARCHS = i386
 
 VER_FILEDESCRIPTION_STR = "Wine Direct3D"
 VER_PRODUCTVERSION      = 5,3,1,904
