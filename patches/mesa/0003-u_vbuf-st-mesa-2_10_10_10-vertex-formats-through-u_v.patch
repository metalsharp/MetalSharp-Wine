From e92ef49efb02feba77c21799d234b042128c1c64 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sun, 22 Nov 2026 17:23:32 -0700
Subject: [PATCH 3/3] u_vbuf, st/mesa: 2_10_10_10 vertex formats through u_vbuf

Metal has only the RGBA normalized 10:10:10:2 vertex formats, so on MoltenVK
zink has no BGRA or scaled ones and GL_ARB_vertex_type_2_10_10_10_rev was not
exposed, which held zink to OpenGL 3.2. u_vbuf now translates the eight formats
to R32G32B32A32_FLOAT, and a vertex format u_vbuf translates counts as
supported for the vertex format extensions (cso enables u_vbuf for it). Zink on
MoltenVK reaches OpenGL 3.3; drawing with all four kinds (RGBA and BGRA
normalized, scaled and signed normalized) gives the expected colours.
---
 src/gallium/auxiliary/util/u_vbuf.c    |  9 ++++++
 src/mesa/state_tracker/st_extensions.c | 45 ++++++++++++++++++++++++--
 2 files changed, 51 insertions(+), 3 deletions(-)

diff --git a/src/gallium/auxiliary/util/u_vbuf.c b/src/gallium/auxiliary/util/u_vbuf.c
index 774d6a0..662846f 100644
--- a/src/gallium/auxiliary/util/u_vbuf.c
+++ b/src/gallium/auxiliary/util/u_vbuf.c
@@ -274,6 +274,15 @@ static const struct {
    { PIPE_FORMAT_R8G8_SSCALED,         PIPE_FORMAT_R32G32_FLOAT },
    { PIPE_FORMAT_R8G8B8_SSCALED,       PIPE_FORMAT_R32G32B32_FLOAT },
    { PIPE_FORMAT_R8G8B8A8_SSCALED,     PIPE_FORMAT_R32G32B32A32_FLOAT },
+   /* GL_ARB_vertex_type_2_10_10_10_rev on drivers without them (MoltenVK: Metal has only the RGBA normalized ones) */
+   { PIPE_FORMAT_R10G10B10A2_UNORM,    PIPE_FORMAT_R32G32B32A32_FLOAT },
+   { PIPE_FORMAT_B10G10R10A2_UNORM,    PIPE_FORMAT_R32G32B32A32_FLOAT },
+   { PIPE_FORMAT_R10G10B10A2_SNORM,    PIPE_FORMAT_R32G32B32A32_FLOAT },
+   { PIPE_FORMAT_B10G10R10A2_SNORM,    PIPE_FORMAT_R32G32B32A32_FLOAT },
+   { PIPE_FORMAT_R10G10B10A2_USCALED,  PIPE_FORMAT_R32G32B32A32_FLOAT },
+   { PIPE_FORMAT_B10G10R10A2_USCALED,  PIPE_FORMAT_R32G32B32A32_FLOAT },
+   { PIPE_FORMAT_R10G10B10A2_SSCALED,  PIPE_FORMAT_R32G32B32A32_FLOAT },
+   { PIPE_FORMAT_B10G10R10A2_SSCALED,  PIPE_FORMAT_R32G32B32A32_FLOAT },
 };
 
 void u_vbuf_get_caps(struct pipe_screen *screen, struct u_vbuf_caps *caps,
diff --git a/src/mesa/state_tracker/st_extensions.c b/src/mesa/state_tracker/st_extensions.c
index 5141068..f56568d 100644
--- a/src/mesa/state_tracker/st_extensions.c
+++ b/src/mesa/state_tracker/st_extensions.c
@@ -41,6 +41,7 @@
 #include "tgsi/tgsi_from_mesa.h"
 #include "util/u_math.h"
 #include "util/u_memory.h"
+#include "util/u_vbuf.h"
 
 #include "st_context.h"
 #include "st_debug.h"
@@ -724,6 +725,45 @@ init_format_extensions(struct pipe_screen *screen,
 }
 
 
+/**
+ * The vertex formats' extensions: a format u_vbuf translates (the cso context enables it for any of them) counts as
+ * supported, as draws give it to u_vbuf.
+ */
+static void
+init_vertex_format_extensions(struct pipe_screen *screen,
+                              struct gl_extensions *extensions,
+                              const struct st_extension_format_mapping *mapping,
+                              unsigned num_mappings)
+{
+   GLboolean *extension_table = (GLboolean *) extensions;
+   struct u_vbuf_caps *caps = CALLOC_STRUCT(u_vbuf_caps);
+   int num_formats = ARRAY_SIZE(mapping->format);
+   int num_ext = ARRAY_SIZE(mapping->extension_offset);
+   unsigned i;
+   int j;
+
+   if (!caps)
+      return;
+   u_vbuf_get_caps(screen, caps, true);
+   for (i = 0; i < num_mappings; i++) {
+      int num_supported = 0;
+
+      for (j = 0; j < num_formats && mapping[i].format[j]; j++) {
+         enum pipe_format format = mapping[i].format[j];
+         if (screen->is_format_supported(screen, format, PIPE_BUFFER, 0, 0, PIPE_BIND_VERTEX_BUFFER) ||
+             caps->format_translation[format] != format)
+            num_supported++;
+      }
+      if (!num_supported ||
+          (!mapping[i].need_at_least_one && num_supported != j))
+         continue;
+      for (j = 0; j < num_ext && mapping[i].extension_offset[j]; j++)
+         extension_table[mapping[i].extension_offset[j]] = GL_TRUE;
+   }
+   FREE(caps);
+}
+
+
 /**
  * Given a list of formats and bind flags, return the maximum number
  * of samples supported by any of those formats.
@@ -1217,9 +1257,8 @@ void st_init_extensions(struct pipe_screen *screen,
                              texture_mapping_compressed_fallback,
                              ARRAY_SIZE(texture_mapping_compressed_fallback),
                              PIPE_TEXTURE_2D, PIPE_BIND_SAMPLER_VIEW);
-   init_format_extensions(screen, extensions, vertex_mapping,
-                          ARRAY_SIZE(vertex_mapping), PIPE_BUFFER,
-                          PIPE_BIND_VERTEX_BUFFER);
+   init_vertex_format_extensions(screen, extensions, vertex_mapping,
+                                 ARRAY_SIZE(vertex_mapping));
 
    /* Figure out GLSL support and set GLSLVersion to it. */
    consts->GLSLVersion = screen->caps.glsl_feature_level;
