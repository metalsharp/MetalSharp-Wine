From 2b90181d92c5abd38938cb60570e03a205aed6a9 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Thu, 22 Oct 2026 04:27:11 -0600
Subject: [PATCH 2/7] FEXCore: Report JIT code writes with
 FlushInstructionCache on Windows.

Wine on W^X hosts (macOS) emulates PAGE_EXECUTE_READWRITE by switching pages
between RX and RW; flushing after writing code lets it switch back without an
execute fault (cold JIT -20%).
---
 .../Source/Interface/Core/Dispatcher/Dispatcher.cpp    |  1 +
 FEXCore/Source/Interface/Core/JIT/JIT.cpp              |  6 ++++++
 FEXCore/include/FEXCore/Utils/AllocatorHooks.h         | 10 ++++++++++
 3 files changed, 17 insertions(+)

diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
index 2f4babd70..a3be3e578 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -666,6 +666,7 @@ void Dispatcher::EmitDispatcher() {
   Start = reinterpret_cast<uint64_t>(DispatchPtr);
   End = GetCursorAddress<uint64_t>();
   ClearICache(reinterpret_cast<void*>(DispatchPtr), End - reinterpret_cast<uint64_t>(DispatchPtr));
+  FEXCore::Allocator::FlushCodeWrites(reinterpret_cast<void*>(DispatchPtr), End - reinterpret_cast<uint64_t>(DispatchPtr));
 
   if (CTX->Config.BlockJITNaming()) {
     fextl::string Name = fextl::fmt::format("Dispatch_{}", FHU::Syscalls::gettid());
diff --git a/FEXCore/Source/Interface/Core/JIT/JIT.cpp b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
index ef7e33299..150036cce 100644
--- a/FEXCore/Source/Interface/Core/JIT/JIT.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -548,6 +548,7 @@ static void DirectBlockDelinker(FEXCore::Context::ExitFunctionLinkData* Record,
 
   std::atomic_ref<uint32_t>(*reinterpret_cast<uint32_t*>(CallerAddress)).store(BranchInst, std::memory_order::relaxed);
   ARMEmitter::Emitter::ClearICache(reinterpret_cast<void*>(CallerAddress), 4);
+  FEXCore::Allocator::FlushCodeWrites(reinterpret_cast<void*>(CallerAddress), 4);
 }
 
 static void IndirectBlockDelinker(FEXCore::Context::ExitFunctionLinkData* Record) {
@@ -559,6 +560,7 @@ static void IndirectBlockDelinker(FEXCore::Context::ExitFunctionLinkData* Record
 
   std::atomic_ref<uint32_t>(*reinterpret_cast<uint32_t*>(JumpThunkStartAddress)).store(BranchInst, std::memory_order::relaxed);
   ARMEmitter::Emitter::ClearICache(reinterpret_cast<void*>(JumpThunkStartAddress), 4);
+  FEXCore::Allocator::FlushCodeWrites(reinterpret_cast<void*>(JumpThunkStartAddress), 4);
 
   // No need to reset HostCode here as the exit linker pointer is stored separately, and if the block is relinked it will be updated.
 }
@@ -626,6 +628,7 @@ uint64_t Arm64JITCore::ExitFunctionLink(FEXCore::Core::CpuStateFrame* Frame, FEX
 
     std::atomic_ref<uint32_t>(*reinterpret_cast<uint32_t*>(CallerAddress)).store(BranchInst, std::memory_order::relaxed);
     ARMEmitter::Emitter::ClearICache(reinterpret_cast<void*>(CallerAddress), 4);
+  FEXCore::Allocator::FlushCodeWrites(reinterpret_cast<void*>(CallerAddress), 4);
   } else {
     // This case is common between calls and jumps as the thunk callsite can be left untouched.
     std::atomic_ref<uint64_t>(Record->HostCode).store(HostCode, std::memory_order::seq_cst);
@@ -639,6 +642,7 @@ uint64_t Arm64JITCore::ExitFunctionLink(FEXCore::Core::CpuStateFrame* Frame, FEX
     LdrEmit.ldr(TMP1, reinterpret_cast<uint64_t>(&Record->HostCode) - JumpThunkStartAddress);
     std::atomic_ref<uint32_t>(*reinterpret_cast<uint32_t*>(JumpThunkStartAddress)).store(LdrInst, std::memory_order::relaxed);
     ARMEmitter::Emitter::ClearICache(reinterpret_cast<void*>(JumpThunkStartAddress), 4);
+  FEXCore::Allocator::FlushCodeWrites(reinterpret_cast<void*>(JumpThunkStartAddress), 4);
 
     Thread->LookupCache->AddBlockLink(GuestRip, Record, IndirectBlockDelinker, lk);
   }
@@ -1166,6 +1170,7 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
   TempCodeBufferAllocator.DelayedDisownBuffer();
 
   ClearICache(CodeBegin, CodeOnlySize);
+  FEXCore::Allocator::FlushCodeWrites(CodeBegin, CodeOnlySize);
 
 #ifdef VIXL_DISASSEMBLER
   if (Disassemble() & FEXCore::Config::Disassemble::STATS) {
@@ -1207,6 +1212,7 @@ CPUBackend::CompiledCode Arm64JITCore::LoadCachedCode(std::span<const uint8_t> H
   uint8_t* Dest = AllocatedInfo.BufferAllocationOffset;
   memcpy(Dest, HostBytes.data(), HostBytes.size());
   ClearICache(Dest, HostBytes.size());
+  FEXCore::Allocator::FlushCodeWrites(Dest, HostBytes.size());
 
   CPUBackend::CompiledCode Result;
   Result.BlockBegin = Dest;
diff --git a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
index c4cadf40a..f9a14490a 100644
--- a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
+++ b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
@@ -11,6 +11,7 @@
 #else
 #define NTDDI_VERSION 0x0A000005
 #include <memoryapi.h>
+#include <processthreadsapi.h>
 #endif
 
 #include <new>
@@ -66,6 +67,13 @@ inline void* VirtualAlloc(size_t Size, bool Execute = false, bool Commit = true)
   return VirtualAlloc(nullptr, Size, Execute, Commit);
 }
 
+// Tell the OS that code was written to an executable allocation. Required semantics on Windows are
+// only the icache flush (already done by ClearICache), but Wine on hosts that enforce W^X (macOS)
+// uses it to make the pages executable again without taking an execute fault.
+inline void FlushCodeWrites(const void* Ptr, size_t Size) {
+  ::FlushInstructionCache(GetCurrentProcess(), Ptr, Size);
+}
+
 inline void VirtualFree(void* Ptr, size_t Size) {
   ::VirtualFree(Ptr, 0, MEM_RELEASE);
 }
@@ -121,6 +129,8 @@ inline void* VirtualAlloc(void* Base, size_t Size, bool Execute = false, bool Co
   return FEXCore::Allocator::mmap(Base, Size, PROT_READ | PROT_WRITE | (Execute ? PROT_EXEC : 0), MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
 }
 
+inline void FlushCodeWrites(const void*, size_t) {}
+
 inline void VirtualFree(void* Ptr, size_t Size) {
   FEXCore::Allocator::munmap(Ptr, Size);
 }
