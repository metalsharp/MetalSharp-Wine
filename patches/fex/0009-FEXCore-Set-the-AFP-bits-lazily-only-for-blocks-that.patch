 }
 
 void Dispatcher::EmitDispatcher() {
+  // The dispatcher computes nothing with FPRs, so it leaves the AFP bits to the code it enters.
+  EmitAFPState = false;
   // Don't modify TMP3 since it contains our RIP once the block doesn't exist
   auto RipReg = TMP3;
