From c247c01f17b5cf07185fec8e3fbf0ec8b13604c2 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sat, 24 Oct 2026 11:21:32 -0600
Subject: [PATCH] FEXCore: Set the AFP bits lazily, only for blocks that
 compute with FPRs

Writing FPCR costs several nanoseconds on Apple cores, and FEX set the AFP
bits (NEP, AH, FIZ) on every entry to JIT code and cleared them on every
exit, two to four writes per crossing between x86 and ARM64EC code.

Set them before the first op of a block that computes with FPRs (moves,
loads and stores don't depend on them), or that saves or writes FPCR
(Push/SetRoundingMode), and only when NEP isn't already set. State
spills and ExitFunctionEC clear them only when NEP is set. tbz/tbnz
keep NZCV, which holds the guest flags, intact. The dispatcher no longer
sets them.

fexprobe (M4, x86_64): TlsGetValue -82%, EnterCriticalSection -74%,
qsort with an x86 callback -66%, QueryPerformanceCounter -55% (i686
-38%), SSE memcpy -26%; FP results unchanged.
---
 .../Core/ArchHelpers/Arm64Emitter.cpp         |  7 +-
 .../Interface/Core/ArchHelpers/Arm64Emitter.h |  7 ++
 .../Interface/Core/Dispatcher/Dispatcher.cpp  |  2 +
 FEXCore/Source/Interface/Core/JIT/JIT.cpp     | 93 +++++++++++++++++++
 FEXCore/Source/Interface/Core/JIT/JITClass.h  |  2 +
 Source/Windows/ARM64EC/Module.S               |  7 +-
 6 files changed, 115 insertions(+), 3 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
index 3ebadb5aa..5a35f689c 100644
--- a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
+++ b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
@@ -636,7 +636,7 @@ void Arm64Emitter::PopCalleeSavedRegisters() {
 
 void Arm64Emitter::FillSpecialRegs(ARMEmitter::Register TmpReg, ARMEmitter::Register TmpReg2, const FillSpecialRegsOptions& Options) {
 #ifndef VIXL_SIMULATOR
-  if (EmitterCTX->HostFeatures.SupportsAFP) {
+  if (EmitterCTX->HostFeatures.SupportsAFP && EmitAFPState) {
     // Enable AFP features when filling JIT state.
     mrs(TmpReg, ARMEmitter::SystemRegister::FPCR);
 
@@ -690,12 +690,17 @@ void Arm64Emitter::SpillStaticRegs(ARMEmitter::Register TmpReg, SpillStaticRegOp
     //
     // Additional interesting AFP bits:
     // FIZ(0): Flush Inputs to Zero
+    // Only write FPCR when they are set: code without FPRs leaves them clear, and NEP is always set with the others.
+    // Test with tbz, which leaves NZCV (the guest flags) alone.
+    ARMEmitter::ForwardLabel l_AFPClear;
     mrs(TmpReg, ARMEmitter::SystemRegister::FPCR);
+    (void)tbz(TmpReg, 2, &l_AFPClear);
     bic(ARMEmitter::Size::i64Bit, TmpReg, TmpReg,
         (1U << 2) |   // NEP
           (1U << 1) | // AH
           (1U << 0)); // FIZ
     msr(ARMEmitter::SystemRegister::FPCR, TmpReg);
+    (void)Bind(&l_AFPClear);
   }
 #endif
 
diff --git a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
