From e8692f4b2ecd9cb9e087ae884a20a54b4f9e8cf9 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sat, 24 Oct 2026 12:07:04 -0600
Subject: [PATCH] FEXCore: Check the L1 cache in the dispatcher

Newly compiled blocks are only added to the thread's L1 cache, and
LookupCache::FindBlock returns L1 hits without filling L2. The
dispatcher's inline lookup only checked L2, so entering such a block from
outside the JIT, e.g. native ARM64EC code calling a guest callback,
went through CompileBlock and a shared lock every time.

Check L1 inline first, the way the JIT's indirect branches do.

fexprobe (M4, x86_64): qsort calling an x86 comparator -45%.
---
 .../Interface/Core/Dispatcher/Dispatcher.cpp     | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
index 08ed3eb61..de1ce1176 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -176,6 +176,22 @@ void Dispatcher::EmitDispatcher() {
 
   ARMEmitter::ForwardLabel NoBlock;
 
+  {
+    // Try the thread's L1 cache first. Newly compiled blocks are only added to L1, and FindBlock returns L1 hits
+    // without filling L2, so without this every entry from outside the JIT (e.g. native code calling a guest
+    // callback on ARM64EC) to such a block would go through CompileBlock.
+    ARMEmitter::ForwardLabel l_L1Miss;
+    ldp<ARMEmitter::IndexType::OFFSET>(TMP1, TMP2, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.L1Pointer));
+    // L1Mask is pre-shifted.
+    and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, RipReg.R(), ARMEmitter::ShiftType::LSL, FEXCore::ilog2(sizeof(LookupCache::LookupCacheEntry)));
+    add(TMP1, TMP1, TMP2);
+    ldp<ARMEmitter::IndexType::OFFSET>(TMP2, TMP1, TMP1, 0);
+    sub(TMP1, TMP1, RipReg);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP1, &l_L1Miss);
+    br(TMP2);
+    (void)Bind(&l_L1Miss);
+  }
+
   if (DisableL2Cache()) {
     (void)b(&NoBlock);
   } else {
