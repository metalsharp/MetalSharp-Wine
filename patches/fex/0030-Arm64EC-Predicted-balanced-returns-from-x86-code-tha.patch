From cf7c0f300bb0615d17f1d20c2d7c0aa5ccd2b652 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Fri, 6 Nov 2026 17:00:25 -0700
Subject: [PATCH 30/30] Arm64EC: Predicted, balanced returns from x86 code that
 native code called

Native code calling x86 code (qsort comparators, window procedures,
enumeration callbacks) enters through ExitToX64, which pushes the native return
address as the guest's. The guest's ret then never matched a call-ret entry:
it took the L1 lookup and an indirect call to the dispatcher, moved the
call-ret stack up an entry each time, and returned to the native caller with a
br, which mispredicted every time.

- EnterEC pushes {native return address, stub} when the top of the guest stack
  is LR, and enters the loop with bl so the stub is on the host return stack;
  the guest's ret pops the entry, is predicted, and the stub hands the return
  address to the top of the loop, which exits to native code as before.
- ExitFunctionEC returns to an exit thunk (after its blr x16) with ret, so that
  return is predicted from the entry the thunk's blr left.

fexprobe sort (qsort of 256 ints with an x86_64 comparator, M6, 16K pages):
26.6 us -> 14.7 us per sort (native 7.3 us). Other probes, bench and CPython
unchanged; outputs of the system tests (SEH, unwind, suspend, exec faults,
debug registers, thread pools) unchanged.
---
 .../Interface/Core/Dispatcher/Dispatcher.cpp  | 27 ++++++++++++++++++-
 Source/Windows/ARM64EC/Module.S               |  8 +++++-
 2 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
index 7a7861ef7..5bbb180f0 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -127,15 +127,40 @@ void Dispatcher::EmitDispatcher() {
 
   // As ARM64EC uses this as an entrypoint for both guest calls and host returns, opportunistically try to return
   // using the call-ret stack to avoid unbalancing it.
+  ARMEmitter::ForwardLabel l_NotReturn;
+  ARMEmitter::ForwardLabel l_ReturnToNative;
   ldp<ARMEmitter::IndexType::OFFSET>(TMP1, TMP2, REG_CALLRET_SP);
   // EC_CALL_CHECKER_PC_REG is REG_PF which isn't touched by any of the above
   sub(ARMEmitter::Size::i64Bit, TMP1, EC_CALL_CHECKER_PC_REG, TMP1);
-  (void)cbnz(ARMEmitter::Size::i64Bit, TMP1, &LoopTop);
+  (void)cbnz(ARMEmitter::Size::i64Bit, TMP1, &l_NotReturn);
 
   // If the entry at the TOS is for the target address, pop it and return to the JIT code
   add(ARMEmitter::Size::i64Bit, REG_CALLRET_SP, REG_CALLRET_SP, 0x10);
   ret(TMP2);
 
+  // Native code calling guest code (qsort comparators, window procedures, enumeration callbacks) comes through
+  // ExitToX64, which pushes the native return address (LR, still in x30) as the guest's return address. Push a
+  // matching call-ret entry so the guest's ret pops it: the stack stays balanced (each such return used to miss and
+  // move it up by an entry until it hit the guard page) and the return goes straight to the native exit check below
+  // instead of through the L1 cache and an indirect call to the dispatcher. Any other entry (a jump into guest code
+  // with something else on the stack) pushes nothing.
+  (void)Bind(&l_NotReturn);
+  ldr(TMP1, StaticRegisters[X86State::REG_RSP], 0);
+  sub(ARMEmitter::Size::i64Bit, TMP1, TMP1, ARMEmitter::XReg::x30);
+  (void)cbnz(ARMEmitter::Size::i64Bit, TMP1, &LoopTop);
+  (void)adr(TMP2, &l_ReturnToNative);
+  stp<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::x30, TMP2, REG_CALLRET_SP, -0x10);
+  // bl, not b: the guest's ret returns through the entry with a host ret, which predicts from the return stack, so
+  // put l_ReturnToNative (the next instruction) on it. With b every such return was mispredicted.
+  (void)bl(&LoopTop);
+
+  // A guest return through such an entry: the entry it just popped holds the return address. The top of the loop
+  // then exits to it if it's native code, as it does for any RIP, or looks it up like any other.
+  (void)Bind(&l_ReturnToNative);
+  ldur(TMP1, REG_CALLRET_SP, -0x10);
+  str(TMP1, STATE_PTR(CpuStateFrame, State.rip));
+  (void)b(&LoopTop);
+
   // Enter JIT
 #endif
 
diff --git a/Source/Windows/ARM64EC/Module.S b/Source/Windows/ARM64EC/Module.S
index 77e6437a9..e8314c1d0 100644
--- a/Source/Windows/ARM64EC/Module.S
+++ b/Source/Windows/ARM64EC/Module.S
@@ -78,7 +78,7 @@ ExitFunctionSuspendResumePoint:
   movk w16, #0xd63f, lsl 16 // blr x16
   ldursw x23, [x17, #-0x4] // Load either the entry thunk offset or the calling instruction.
   cmp w23, w16
-  beq ret_sp_aligned
+  beq ret_to_exit_thunk
 
   and x23, x23, #-0x4
   add x17, x17, x23 // Resolve entry thunk address.
@@ -91,6 +91,12 @@ ExitFunctionSuspendResumePoint:
 ret_sp_aligned:
   br x17
 
+ret_to_exit_thunk:
+  // A return to the exit thunk whose 'blr x16' called into x86 code: return with ret so the return is predicted from
+  // the return stack, where that blr left it (the dispatcher's native-call entry keeps the stack balanced in between).
+  // A br here was mispredicted on every return from an x86 callback (qsort comparators, window procedures).
+  ret x17
+
 ret_sp_misaligned:
   // In the case of the x64 caller leaving sp only 8-byte aligned, leave the return address on the stack to keep 16-byte
   // alignment and have the callee return to an x86 ret instruction. FEX can then return to the actual caller keeping
-- 
