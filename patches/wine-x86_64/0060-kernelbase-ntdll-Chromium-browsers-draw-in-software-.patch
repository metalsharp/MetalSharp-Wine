             return wargv;
     for (p = wargv[0]; *p; p++) if (*p == '\\' || *p == '/') name = p + 1;
     dir_len = name - wargv[0];
@@ -2135,13 +2139,19 @@ static WCHAR **chromium_in_process_gpu( WCHAR **wargv )
