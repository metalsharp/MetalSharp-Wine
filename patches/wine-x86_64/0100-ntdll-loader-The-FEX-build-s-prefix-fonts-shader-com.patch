From 4989e1c993952677bbfff5ce73da6a27f018c411 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Thu, 26 Nov 2026 09:38:15 -0700
Subject: [PATCH 100/100] ntdll, loader: The FEX build's prefix fonts, shader compilers
 and file fixes, on x86_64 too.

- wine.inf: real arial/times/cour/tahoma .ttf files in C:\windows\Fonts (Liberation,
  for Unity's dynamic fonts), CJK families mapped onto the macOS system fonts (text
  in Japanese, Chinese and Korean showed boxes), and Microsoft's shader compilers
  (DXC, and d3dcompiler_47 in place of Wine's vkd3d-shader one, for 64-bit programs).
- NtSetInformationFile: FileAllocationInformation, which failed: an allocation below
  the end of file truncates the file to it, one at or past it is accepted.
- A path through a file reports STATUS_OBJECT_PATH_NOT_FOUND, as on Windows.
- MoltenVK logs errors only (MVK_CONFIG_LOG_LEVEL=1), not its feature list for every
  instance.
---
 dlls/ntdll/unix/file.c   | 30 ++++++++++++++++
 dlls/ntdll/unix/loader.c |  3 ++
 loader/wine.inf.in       | 76 +++++++++++++++++++++++++++++++++++++++-
 3 files changed, 108 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 2a5384dc6cb..c2cfd9b5731 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2685,6 +2685,14 @@ static NTSTATUS find_file_in_dir( int root_fd, char *unix_name, int pos, const W
     {
         unix_name[pos + ret] = 0;
         if (!fstatat( root_fd, unix_name, &st, 0 )) return STATUS_SUCCESS;
+        /* The "directory" is a file. On a case-sensitive file system the search below opens it and fails the
+         * same way; on a case-insensitive one (macOS) nothing is searched, and the name was reported as not
+         * found where Windows reports the path. */
+        if (errno == ENOTDIR)
+        {
+            unix_name[pos - 1] = 0;
+            return STATUS_OBJECT_PATH_NOT_FOUND;
+        }
     }
     if (check_case) goto not_found;  /* we want an exact match */
 
@@ -4983,6 +4991,28 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         else status = STATUS_INVALID_PARAMETER_3;
         break;
 
+    case FileAllocationInformation:
+        /* MetalSharp: an allocation below the end of file truncates the file to it; one at or past it only
+         * reserves space, which the host file system does as the file grows. */
+        if (len >= sizeof(FILE_ALLOCATION_INFORMATION))
+        {
+            const FILE_ALLOCATION_INFORMATION *info = ptr;
+            struct stat st;
+
+            if (fstat( fd, &st ) == -1) status = errno_to_status( errno );
+            else if (info->AllocationSize.QuadPart < 0) status = STATUS_INVALID_PARAMETER;
+            else if (info->AllocationSize.QuadPart < st.st_size)
+            {
+                FILE_END_OF_FILE_INFORMATION eof;
+
+                eof.EndOfFile.QuadPart = info->AllocationSize.QuadPart;
+                if (needs_close) close( fd );
+                return server_set_file_info( handle, io, &eof, sizeof(eof), FileEndOfFileInformation );
+            }
+        }
+        else status = STATUS_INVALID_PARAMETER_3;
+        break;
+
     case FileCompletionInformation:
         if (len >= sizeof(FILE_COMPLETION_INFORMATION))
         {
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 431f3f66b85..ec71fc9e28e 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -336,6 +336,9 @@ static void set_metalsharp_runtime_defaults(void)
     char *dir;
 
     if (!dll_dir) return;
+    /* MoltenVK logs its whole feature list at info level on every instance; keep errors only */
+    setenv( "MVK_CONFIG_LOG_LEVEL", "1", 0 );
+
     if ((!getenv( "WFDXCOMPAT_RUNTIME_DIR" ) || !getenv( "WFDXCOMPAT_RUNTIME_DIR" )[0]) &&
         (dir = metalsharp_runtime_dir( wfdxcompat, "x86_64-windows/wfdx-launchers-v1.dll" )))
     {
diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index 11d17b54eef..9e5ecf0d6cb 100644
