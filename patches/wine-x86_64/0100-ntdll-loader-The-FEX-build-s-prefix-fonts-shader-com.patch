 [MCI]
 HKLM,%Mci32Str%,"AVIVideo",,"mciavi32.dll"
@@ -1349,12 +1383,52 @@ windows.system.winmd
 windows.ui.winmd
 windows.ui.xaml.winmd
 
+; MetalSharp: real files in C:\windows\Fonts for programs that open fonts there by file name
+; (Unity's dynamic fonts). Liberation is metric-compatible with Arial, Times New Roman and Courier New;
+; the flag (COPYFLG_NO_OVERWRITE) keeps a real Microsoft font already in the prefix.
+[FontFiles]
+arial.ttf,,,0x10
+arialbd.ttf,,,0x10
+ariali.ttf,,,0x10
+arialbi.ttf,,,0x10
+times.ttf,,,0x10
+timesbd.ttf,,,0x10
+timesi.ttf,,,0x10
+timesbi.ttf,,,0x10
+cour.ttf,,,0x10
+courbd.ttf,,,0x10
+couri.ttf,,,0x10
+courbi.ttf,,,0x10
+tahoma.ttf,,,0x10
+tahomabd.ttf,,,0x10
+
+; MetalSharp: Microsoft's shader compilers (scripts/stage-shader-compilers.sh), for programs that compile
+; HLSL at run time: DXC, and Microsoft's d3dcompiler_47 in place of Wine's, whose vkd3d-shader miscompiles some
+; shaders. 32-bit programs keep Wine's d3dcompiler_47, which the override falls back to
+[ShaderCompilers.ntamd64]
+d3dcompiler_47.dll
+dxcompiler.dll
+dxil.dll
+
+[ShaderCompilers.ntx86]
+dxcompiler.dll
+dxil.dll
+
+[ShaderCompilerOverrides]
+HKCU,Software\Wine\DllOverrides,"d3dcompiler_47",,"native,builtin"
+
 [WineSourceDirs]
+FontFiles = fonts
+ShaderCompilers.ntamd64 = shadercompilers\x64
+ShaderCompilers.ntx86 = shadercompilers\x86
 NlsFiles  = nls
 SortFiles = nls
 WinmdFiles = winmd,include
 
 [DestinationDirs]
+FontFiles = 20
+ShaderCompilers.ntamd64 = 11
+ShaderCompilers.ntx86 = 11
 ColorFiles = 23
 EtcFiles  = 12,etc
 InfFiles  = 17
