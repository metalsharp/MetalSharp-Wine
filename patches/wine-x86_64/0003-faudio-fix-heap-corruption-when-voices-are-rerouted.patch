From 523e8ab68d9891a8e48798f3431c67d79ee93fba Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Sun, 18 Oct 2026 08:41:59 -0600
Subject: [PATCH 03/59] faudio: fix heap corruption when voices are rerouted

Wolfenstein: The New Order reroutes its music as the player enters a turret,
and FAudio's mixing thread wrote decoded audio over the heap:

- The resampler's tap loops could emit more samples than the pass makes
  after a sample rate change, and toResample - tap_samples wrapped around:
  the SSE2 resampler wrote far past resampled_audio. The loops now stop at
  toResample.
- The decode loop took its output pointer into decoded_audio and the queued
  buffer before start_buffer, which unlocks the voice for OnBufferStart;
  end_buffer wrote through its buffer pointer after OnLoopEnd. A callback
  that submits buffers or creates voices reallocates both: they are taken
  again after the callbacks.
- The resample step was recomputed only when the voice's frequency changed,
  not when its output's rate did: rerouting now makes the next mix
  recompute it.
- Decoding is clamped to the voice's decodeSamples, and unaligned bytes that
  would overflow their block-sized stash are dropped, where release builds
  compiled the asserts out.
---
 libs/faudio/src/FAudio_internal.c | 78 ++++++++++++++++++++++++++-----
 1 file changed, 67 insertions(+), 11 deletions(-)

diff --git a/libs/faudio/src/FAudio_internal.c b/libs/faudio/src/FAudio_internal.c
index eb059ce6..05981180 100644
--- a/libs/faudio/src/FAudio_internal.c
+++ b/libs/faudio/src/FAudio_internal.c
@@ -433,15 +433,33 @@ static void save_unaligned_end_data(FAudioSourceVoice *voice, const struct queue
 		end_pos += buffer->play_bytes;
 	}
 
-	if (byte_pos == end_pos)
+	if (byte_pos >= end_pos)
 		return;
 
 	/* If the last buffer was also unaligned, and this one
 	 * wasn't big enough to complete the block, then we'll
 	 * already have some unaligned bytes. If this one was
 	 * big enough to complete the block, we shouldn't have
-	 * any bytes left over from the last buffer. */
-	FAudio_assert(voice->src.unaligned_size + (end_pos - byte_pos) < block_size);
+	 * any bytes left over from the last buffer.
+	 *
+	 * Bytes left over that no buffer collected (the queue was
+	 * flushed, or a buffer ended the stream) would overflow the
+	 * block-sized stash, into whatever follows it on the heap:
+	 * drop them instead. (Wolfenstein: The New Order flushes its
+	 * music voices at state changes and crashed on the heap
+	 * damage.) */
+	if (voice->src.unaligned_size + (end_pos - byte_pos) >= block_size)
+	{
+		LOG_ERROR(
+			voice->audio,
+			"Dropping %u stale unaligned bytes (block %u)",
+			voice->src.unaligned_size,
+			block_size
+		)
+		voice->src.unaligned_size = 0;
+		if (end_pos - byte_pos >= block_size)
+			return;
+	}
 
 	if (!voice->src.unaligned_data)
 		voice->src.unaligned_data = voice->audio->pMalloc(block_size);
@@ -523,6 +541,9 @@ static void end_buffer(FAudioSourceVoice *voice)
 
 			FAudio_PlatformLockMutex(voice->src.bufferLock);
 			LOG_MUTEX_LOCK(voice->audio, voice->src.bufferLock)
+
+			/* OnLoopEnd may have submitted buffers, reallocating the queue. */
+			buffer = &voice->src.queued_buffers[0];
 		}
 
 		buffer->first_block_offset = 0;
@@ -643,19 +664,39 @@ static void FAudio_INTERNAL_DecodeBuffers(
 
 	LOG_FUNC_ENTER(voice->audio)
 
-	/* This should never go past the max ratio size */
-	FAudio_assert(*toDecode <= voice->src.decodeSamples);
+	/* This should never go past the max ratio size. If it does, decoding
+	 * would write past the end of decoded_audio, into the heap. */
+	if (*toDecode > voice->src.decodeSamples)
+	{
+		LOG_ERROR(
+			voice->audio,
+			"Decoding %llu samples, more than the %u the voice holds",
+			(unsigned long long) *toDecode,
+			voice->src.decodeSamples
+		)
+		*toDecode = voice->src.decodeSamples;
+	}
 
 	while (decoded < *toDecode && voice->src.queued_buffer_count)
 	{
-		float *dst = voice->audio->decoded_audio + (decoded * voice->src.format->nChannels);
-		struct queued_buffer *buffer = &voice->src.queued_buffers[0];
+		float *dst;
+		struct queued_buffer *buffer;
 		uint32_t decode_count;
 
+		/* This may queue a buffer in front, reallocating the queue. */
 		try_collect_unaligned_data(voice);
 
 		/* Start-of-buffer behavior */
-		start_buffer(voice, buffer);
+		start_buffer(voice, &voice->src.queued_buffers[0]);
+
+		/* Only now: start_buffer unlocks the voice for OnBufferStart, whose
+		 * application may submit buffers (reallocating queued_buffers) or
+		 * create voices (reallocating decoded_audio), and pointers taken
+		 * before it would decode into freed memory. (Wolfenstein: The New
+		 * Order changes its music as the player enters a turret, and the
+		 * floats written to freed memory corrupted the heap.) */
+		buffer = &voice->src.queued_buffers[0];
+		dst = voice->audio->decoded_audio + (decoded * voice->src.format->nChannels);
 
 		/* Number of samples we are decoding in one call. */
 		decode_count = FAudio_min(*toDecode - decoded,
@@ -1166,8 +1207,17 @@ static void FAudio_INTERNAL_MixSource(FAudioSourceVoice *voice)
 		 * contradicts the behaviour when the sample rates match. */
 
 		/* First, everything between the last 2 samples of the
-		 * previous quantum, if we didn't output them all yet. */
-		while ((voice->src.resampleOffset >> FIXED_PRECISION) < (prev_sample_count - 1))
+		 * previous quantum, if we didn't output them all yet.
+		 *
+		 * Both tap loops stop at toResample: after the step changes
+		 * (the voice is sent to an output of another rate, or its
+		 * frequency ratio changes) they can owe more samples than this
+		 * pass makes, and toResample - tap_samples below would wrap
+		 * around, resampling far past the end of resampled_audio.
+		 * (Wolfenstein: The New Order reroutes its music as the
+		 * player enters a turret.) */
+		while (	tap_samples < toResample &&
+			(voice->src.resampleOffset >> FIXED_PRECISION) < (prev_sample_count - 1))
 		{
 			float frac = fixed_to_float(voice->src.resampleOffset & FIXED_FRACTION_MASK);
 
@@ -1180,7 +1230,8 @@ static void FAudio_INTERNAL_MixSource(FAudioSourceVoice *voice)
 
 		/* Then the samples between the last sample of the
 		 * previous quantum and the first sample of this one. */
-		while ((voice->src.resampleOffset >> FIXED_PRECISION) < prev_sample_count)
+		while (	tap_samples < toResample &&
+			(voice->src.resampleOffset >> FIXED_PRECISION) < prev_sample_count)
 		{
 			float frac = fixed_to_float(voice->src.resampleOffset & FIXED_FRACTION_MASK);
 
@@ -1814,6 +1865,11 @@ uint32_t FAudio_INTERNAL_VoiceOutputFrequency(
 			return FAUDIO_E_INVALID_CALL;
 		}
 		voice->src.resampleSamples = newResampleSamples;
+
+		/* The resample step depends on the output rate too: make
+		 * the next mix compute it for this output, or it decodes
+		 * more samples than decoded_audio holds. */
+		voice->src.resampleFreq = 0.0f;
 	}
 	else /* (voice->type == FAUDIO_VOICE_SUBMIX) */
 	{
