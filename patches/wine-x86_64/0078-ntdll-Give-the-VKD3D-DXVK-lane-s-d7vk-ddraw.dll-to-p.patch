From 2816b356156fedcd7311bf88125d811a49a66ecc Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sat, 21 Nov 2026 13:32:25 -0700
Subject: [PATCH 78/79] ntdll: Give the VKD3D/DXVK lane's d7vk ddraw.dll to
 programs.

With GRAPHICS_BACKEND=dxvk (or vkd3d), ddraw.dll comes from the lane's
vkd3d/dxvk/<arch>, where DXVK-MacOS now has d7vk's (D3D7, 6, 5 and 3 on
DXVK's D3D9), for x86_64 and i386 programs.

d7vk passes DirectDraw itself on to a real ddraw, which it loads as
ddraw_.dll: Wine's own, installed in the prefix under that name. Its export
name is ddraw.dll, so the loader does not give that file the lane's ddraw.dll.
---
 dlls/ntdll/unix/loader.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 41a5c27..1638eb1 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1449,11 +1449,29 @@ static char *zink_pe_path( const char *name, USHORT machine )
     return NULL;
 }
 
+/* d7vk's ddraw.dll passes DirectDraw itself on to a real ddraw, which it loads as ddraw_.dll: Wine's own, installed
+ * in the prefix under that name (lib/wine/<arch>/ddraw_.dll). Its export name is ddraw.dll, so it must not be
+ * given the lane's ddraw.dll, which is d7vk again. */
+static BOOL is_d7vk_proxy_file( const UNICODE_STRING *nt_name )
+{
+    static const WCHAR proxy[] = {'d','d','r','a','w','_','.','d','l','l'};
+    unsigned int i, len = nt_name->Length / sizeof(WCHAR), start = 0;
+
+    for (i = 0; i < len; i++)
+        if (nt_name->Buffer[i] == '/' || nt_name->Buffer[i] == '\\') start = i + 1;
+    if (len - start != ARRAY_SIZE(proxy)) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(proxy); i++)
+        if (ntdll_towlower( nt_name->Buffer[start + i] ) != proxy[i]) return FALSE;
+    return TRUE;
+}
+
 static char *resolve_vkd3d_lane_pe_path( const char *module, USHORT machine )
 {
     static const char *const vkd3d_names[] = { "d3d12.dll", "d3d12core.dll", "dxgi.dll", "d3d11.dll", "d3d10core.dll",
                                                "nvngx.dll", "nvapi64.dll" };
-    static const char *const dxvk_names[] = { "d3d9.dll", "d3d8.dll", "d3d11.dll", "d3d10core.dll", "dxgi.dll" };
+    /* ddraw.dll is d7vk's (D3D7, 6, 5 and 3 on DXVK's D3D9), where the lane has it */
+    static const char *const dxvk_names[] = { "ddraw.dll", "d3d9.dll", "d3d8.dll", "d3d11.dll", "d3d10core.dll",
+                                              "dxgi.dll" };
     const char *name = strrchr( module, '/' );
     unsigned int i;
 
@@ -1659,7 +1677,7 @@ static NTSTATUS find_builtin_dll( UNICODE_STRING *nt_name, ANSI_STRING *exp_name
 
     /* MetalSharp: the VKD3D lane's PE modules, no unix side */
     {
-        char *lane_pe = resolve_vkd3d_lane_pe_path( file + pos + 1, search_machine );
+        char *lane_pe = is_d7vk_proxy_file( nt_name ) ? NULL : resolve_vkd3d_lane_pe_path( file + pos + 1, search_machine );
 
         if (lane_pe)
         {
