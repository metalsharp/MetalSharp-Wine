From 2993fc06ee970a65b1185e04bb36b54e4b261820 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sun, 1 Nov 2026 17:36:58 -0700
Subject: [PATCH 91/91] winemac.drv: Keep ELDEN RING out of native fullscreen as
 Steam starts it too.

Steam starts it as Game\start_protected_game.exe, which MetalSharp replaces with a copy of
eldenring.exe to start it without EasyAntiCheat, so the eldenring.exe rule never applied to
MetalSharp's launches: in native fullscreen Wine kept its view at the emulated mode's size and
macOS scaled it, so there was nothing for MetalFX to upscale, and its resolution changes reverted.

(cherry picked from commit 2028ba3b2024b9ff63352b1ec43ce1d860a46b8b)
---
 dlls/winemac.drv/macdrv_main.c | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/dlls/winemac.drv/macdrv_main.c b/dlls/winemac.drv/macdrv_main.c
index 5e51d7328ab..d633f58b313 100644
--- a/dlls/winemac.drv/macdrv_main.c
+++ b/dlls/winemac.drv/macdrv_main.c
@@ -353,11 +353,21 @@ static void setup_options(void)
 
     /* MetalSharp hack: ELDEN RING can't change its resolution or screen mode
      * in native macOS fullscreen, which keeps resizing its window back to the
-     * screen, so it reverts every change. The NativeFullscreen option still
-     * overrides this. */
+     * screen, so it reverts every change. Steam starts it as
+     * Game\start_protected_game.exe, which MetalSharp replaces with a copy of
+     * eldenring.exe to start it without EasyAntiCheat. The NativeFullscreen
+     * option still overrides this. */
     {
         static const WCHAR eldenringW[] = {'e','l','d','e','n','r','i','n','g','.','e','x','e',0};
-        if (!wcsicmp(appname, eldenringW)) native_fullscreen = false;
+        static const WCHAR protectedW[] = {'\\','E','L','D','E','N',' ','R','I','N','G','\\','G','a','m','e','\\',
+                                           's','t','a','r','t','_','p','r','o','t','e','c','t','e','d','_',
+                                           'g','a','m','e','.','e','x','e',0};
+        const WCHAR *image = RtlGetCurrentPeb()->ProcessParameters->ImagePathName.Buffer;
+        size_t image_len = lstrlenW(image), protected_len = ARRAY_SIZE(protectedW) - 1;
+
+        if (!wcsicmp(appname, eldenringW) ||
+            (image_len >= protected_len && !wcsicmp(image + image_len - protected_len, protectedW)))
+            native_fullscreen = false;
     }
     /* MetalSharp: a game shown a display divided by its MetalFX factor (an emulated mode) stays out of native
      * fullscreen too: macOS sizing the window to the screen raced the emulated mode's scaling of the game's
