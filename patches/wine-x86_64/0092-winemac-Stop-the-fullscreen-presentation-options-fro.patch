From 3fea95b78d725d91b2258263e2a99cb10bad80d9 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Thu, 19 Nov 2026 00:04:34 -0700
Subject: [PATCH 92/92] winemac: Stop the fullscreen presentation options from
 looping

Apply the presentation options when this app's own options differ,
not whenever the system's current options differ. macOS doesn't
always take them (while focus moves between apps, say), and setting
them notified the observer again, which looped on the main thread and
could hang the display. As a last resort, stop after 20 changes in a
second until the window's state changes.

(cherry picked from commit c1e20bd530d92d9ed64268e22fa48cc3f724b4d0)
---
 dlls/winemac.drv/cocoa_fullscreen.m | 29 +++++++++++++++++++++--------
 1 file changed, 21 insertions(+), 8 deletions(-)

diff --git a/dlls/winemac.drv/cocoa_fullscreen.m b/dlls/winemac.drv/cocoa_fullscreen.m
index 5f700a1c85b..f4afbd537e6 100644
--- a/dlls/winemac.drv/cocoa_fullscreen.m
+++ b/dlls/winemac.drv/cocoa_fullscreen.m
@@ -44,6 +44,8 @@ @interface WineDarwinFullscreenPresentation : NSObject
     NSWindow *owner;
     BOOL owned, failed;
     BOOL observingOptions, settingOptions, updateQueued;
+    NSTimeInterval burstStart;
+    int burstCount;
 }
 + (instancetype) sharedController;
 - (void) update;
@@ -188,15 +190,26 @@ - (void) update
     @try
     {
         NSApplicationPresentationOptions options = macdrv_cocoa_fullscreen_options(window, savedOptions);
-        NSApplicationPresentationOptions controlled = NSApplicationPresentationHideDock |
-            NSApplicationPresentationAutoHideDock | NSApplicationPresentationHideMenuBar |
-            NSApplicationPresentationAutoHideMenuBar | NSApplicationPresentationAutoHideToolbar;
-#ifdef MAC_OS_VERSION_27_0
-        if (@available(macOS 27.0, *)) controlled |= NSApplicationPresentationDisableScreenCornerInteractions;
-#endif
-        if (NSApp.presentationOptions != options ||
-            ((NSApp.currentSystemPresentationOptions ^ options) & controlled))
+        /* MetalSharp: apply the options when what this app asks for differs, not whenever the system's current
+         * options differ: macOS doesn't always take them (while focus moves between apps, say), and setting them
+         * notifies this observer again, which looped on the main thread and could hang the display. As a last
+         * resort, stop after many changes in a second until the window's state changes. */
+        if (NSApp.presentationOptions != options)
+        {
+            NSTimeInterval now = [NSDate timeIntervalSinceReferenceDate];
+            if (now - burstStart > 1.0)
+            {
+                burstStart = now;
+                burstCount = 0;
+            }
+            if (++burstCount > 20)
+            {
+                failed = YES;
+                NSLog(@"Wine fullscreen presentation: macOS keeps changing the options; leaving them");
+                return;
+            }
             [self setOptions:options];
+        }
     }
     @catch (NSException *exception)
     {
