index 7a511ce3a97..990759730e9 100644
--- a/dlls/ntdll/unix/graphics_policy.c
+++ b/dlls/ntdll/unix/graphics_policy.c
@@ -131,15 +131,15 @@ void init_process_graphics_backend( const WCHAR *image_path )
     if (process_uses_launcher_dxmt)
         process_graphics_backend = PROCESS_GRAPHICS_BACKEND_DXMT;
 
-    /* WineForge-Internal: wfdxcompat/rockstar-launcher-policy-v1. */
+    /* WineForge-Internal: wfdxcompat/rockstar-launcher-policy-v1. MetalSharp: as on the arm64
+     * runtime, the Rockstar Games Launcher and SocialClubHelper run on Mullion with WFDXCompat's
+     * launcher companion interposing D3D11 device creation. On D3DMetal their UI's D3D11 device
+     * could not be created (metalsharp/MetalSharp-Wine#113). */
     process_uses_wfdx_launchers = FALSE;
-    if (launcher.wfdx)
+    if (launcher.wfdx && dxmt_runtime_available())
     {
-        process_graphics_backend = PROCESS_GRAPHICS_BACKEND_D3DMETAL;
-        if (wfdxcompat_launcher_runtime_available())
-            process_uses_wfdx_launchers = TRUE;
-        else
-            process_graphics_backend = configured_backend;
+        process_graphics_backend = PROCESS_GRAPHICS_BACKEND_DXMT;
+        process_uses_wfdx_launchers = wfdxcompat_launcher_runtime_available();
     }
 
     TRACE( "graphics backend for %s: global %s, selected %s, policy %s%s%s\n", image_nameA,
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 5654f0b776d..431f3f66b85 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1543,6 +1543,28 @@ static NTSTATUS find_builtin_dll( UNICODE_STRING *nt_name, ANSI_STRING *exp_name
         goto done;
     }
 
+    /* WineForge-Internal: wfdxcompat-runtime-loader-v1. MetalSharp: the launcher companion, PE
+     * only, in the launcher processes the policy put on Mullion, as on the arm64 runtime. */
+    if (wfdxcompat_launcher_runtime_enabled() && is_wfdxcompat_launcher_module_name( file + pos + 1 ))
+    {
+        char *companion = resolve_wfdxcompat_launcher_pe_path( search_machine );
+
+        if (companion)
+        {
+            status = open_builtin_pe_file( companion, &attr, module, size_ptr, image_info,
+                                           limit_low, limit_high, load_machine, prefer_native, offset );
+            TRACE( "WFDXCompat launcher companion %s for %s -> %#lx\n",
+                   debugstr_a(companion), debugstr_us(nt_name), (long)status );
+            free( companion );
+            if (status != STATUS_DLL_NOT_FOUND)
+            {
+                ptr = file + pos;
+                wfdxcompat_runtime_pe = TRUE;  /* no unix side */
+                goto done;
+            }
+        }
+    }
+
     /* WineForge-Internal: load DXCompat before the selected D3DMetal backend. */
     if (d3dmetal_graphics_backend_enabled() &&
         is_wfdxcompat_frontend_module_name( file + pos + 1 ))
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
