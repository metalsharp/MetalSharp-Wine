 dlls/ntdll/unix/graphics_policy.c   | 14 ++++----
 dlls/ntdll/unix/loader.c            | 22 +++++++++++++
 dlls/ntdll/unix/unix_private.h      |  2 ++
 dlls/ntdll/unix/wfdxcompat_loader.c | 48 ++++++++++++++++++---------
 dlls/ntdll/wfdxcompat_loader.c      | 51 +++++++++++++++++++++++++----
 5 files changed, 108 insertions(+), 29 deletions(-)

