From 55586f3739bca139a444072aaee5c6f7522e777d Mon Sep 17 00:00:00 2001
From: Mason <masond3v@protonmail.com>
Date: Sun, 15 Nov 2026 10:19:57 -0500
Subject: [PATCH 65/66] dbghelp: Expose PDB public symbols and report folded
 functions by their own name.

Wine 10.5's new PDB reader dropped S_PUB32 records, so SymEnumSymbols and
SymFromName no longer found decorated names. Functions folded onto one address
were all reported under one name. Custom Shaders Patch resolves Assetto Corsa's
functions this way and failed to initialize ("Failed to initialize").

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/dbghelp/pdb.c    | 23 +++++++++++++++++++++++
 dlls/dbghelp/symbol.c | 37 +++++++++++++++++++++++++++++++++----
 2 files changed, 56 insertions(+), 4 deletions(-)

diff --git a/dlls/dbghelp/pdb.c b/dlls/dbghelp/pdb.c
index ac7863cade..a94316d156 100644
--- a/dlls/dbghelp/pdb.c
+++ b/dlls/dbghelp/pdb.c
@@ -2083,6 +2083,29 @@ static enum pdb_result pdb_reader_init_DBI(struct pdb_reader *pdb)
             }
         }
     }
+
+    /* Public symbols (S_PUB32) aren't indexed by the globals' hash table, but applications
+     * (e.g. Assetto Corsa's Custom Shaders Patch) look up decorated names through
+     * SymEnumSymbols()/SymFromName(), as the previous PDB reader allowed. Expose them as
+     * public symbols, as the previous reader did. */
+    if (whole.data)
+    {
+        unsigned stream_size = pdb->toc->stream_size[whole.stream_id], offset;
+
+        for (offset = 0; offset + sizeof(cv_symbol->generic) <= stream_size;
+             offset += cv_symbol->generic.len + sizeof(cv_symbol->generic.len))
+        {
+            DWORD64 address;
+
+            if (pdb_reader_whole_stream_access_codeview_symbol(pdb, &whole, offset, &cv_symbol)) break;
+            if (cv_symbol->generic.len < sizeof(cv_symbol->generic.id)) break;
+            if (cv_symbol->generic.id != S_PUB32) continue;
+            if (pdb_reader_get_segment_address(pdb, cv_symbol->public_v3.segment, cv_symbol->public_v3.offset, &address))
+                continue;
+            symt_new_public(pdb->module, NULL, cv_symbol->public_v3.name,
+                            cv_symbol->public_v3.pubsymflags == SYMTYPE_FUNCTION, address, 1);
+        }
+    }
     pdb_reader_dispose_whole_stream(pdb, &whole);
 
     /* Note: rva is not unique */
diff --git a/dlls/dbghelp/symbol.c b/dlls/dbghelp/symbol.c
index dfac47f294..efd794fffc 100644
--- a/dlls/dbghelp/symbol.c
+++ b/dlls/dbghelp/symbol.c
@@ -1008,11 +1008,29 @@ static BOOL symbol_enum_method_cb(symref_t symref, const char *name, void *user)
 {
     struct symbol_enum_method *sem = user;
 
-    sem->se->sym_info->SizeOfStruct = sizeof(SYMBOL_INFO);
-    sem->se->sym_info->MaxNameLen = sizeof(sem->se->buffer) - sizeof(SYMBOL_INFO);
+    const struct sym_enum *se = sem->se;
+    SYMBOL_INFO *si = se->sym_info;
 
-    send_symbol(sem->se, sem->pair, NULL, symref);
-    return TRUE;
+    si->SizeOfStruct = sizeof(SYMBOL_INFO);
+    si->MaxNameLen = sizeof(se->buffer) - sizeof(SYMBOL_INFO);
+
+    if (!symt_fill_sym_info_from_symref(sem->pair, NULL, symref, si)) return TRUE;
+    /* Identical functions folded by the linker share one address, hence one symref. Report
+     * each one under the name it was enumerated with, not the first one at that address. */
+    if (name && strcmp(si->Name, name))
+    {
+        unsigned len = strlen(name);
+
+        if (len >= si->MaxNameLen) len = si->MaxNameLen - 1;
+        memcpy(si->Name, name, len);
+        si->Name[len] = 0;
+        si->NameLen = len;
+    }
+    if (se->index && si->Index != se->index) return TRUE;
+    if (se->tag && si->Tag != se->tag) return TRUE;
+    if (se->addr && !(se->addr >= si->Address && se->addr < si->Address + si->Size)) return TRUE;
+    /* returning FALSE stops the enumeration, as the application's callback does */
+    return se->cb(si, si->Size, se->user);
 }
 
 static BOOL symt_enum_module(struct module_pair* pair, const WCHAR* match,
@@ -1781,6 +1799,17 @@ static BOOL find_name(struct process* pcs, struct module* module, const char* na
         if (result == MR_SUCCESS)
         {
             symt_fill_sym_info_from_symref(&pair, NULL, symref, symbol);
+            /* Identical functions folded by the linker share one address, hence one symref:
+             * report the symbol under the name that was looked up. */
+            if (strcmp(symbol->Name, name) && symbol->MaxNameLen)
+            {
+                unsigned len = strlen(name);
+
+                if (len >= symbol->MaxNameLen) len = symbol->MaxNameLen - 1;
+                memcpy(symbol->Name, name, len);
+                symbol->Name[len] = 0;
+                symbol->NameLen = len;
+            }
             return TRUE;
         }
         if (result != MR_NOT_FOUND) return FALSE;
