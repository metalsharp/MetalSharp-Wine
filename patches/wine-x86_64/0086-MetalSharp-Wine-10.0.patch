From ffdf9dad2e1b9614159c213cf0547437508b06ee Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Thu, 26 Nov 2026 00:03:37 -0700
Subject: [PATCH 86/86] MetalSharp Wine 10.0.

The version reads "MetalSharp Wine 10.0", as the arm64 build's does.
---
 METALSHARP_VERSION | 2 +-
 configure          | 2 +-
 configure.ac       | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/METALSHARP_VERSION b/METALSHARP_VERSION
index d3827e75a5c..2f52450b31d 100644
--- a/METALSHARP_VERSION
+++ b/METALSHARP_VERSION
@@ -1 +1 @@
-1.0
+10.0
diff --git a/configure b/configure
index 0379eb3030d..17ff10cf907 100755
--- a/configure
+++ b/configure
@@ -23287,7 +23287,7 @@ as_fn_append wine_rules "
 dlls/ntdll/unix/version.c: dummy
 	@base=\`GIT_DIR=${wine_srcdir}.git git describe HEAD 2>/dev/null || echo \"wine-\$(PACKAGE_VERSION)\"\`; \\
 	metalsharp=\`sed -n -e '1{s/^MetalSharp version[[:space:]]*//;s/^[[:space:]]*//;s/[[:space:]]*\$\$//;p;q;}' ${wine_srcdir}METALSHARP_VERSION 2>/dev/null\`; \\
-	test -z \"\$\$metalsharp\" || base=\"\$\$base (MetalSharp \$\$metalsharp)\"; \\
+	test -z \"\$\$metalsharp\" || base=\"\$\$base (MetalSharp Wine \$\$metalsharp)\"; \\
 	version=\`printf '%s\n' \"\$\$base\" | sed -n -e '\$\$s/\(.*\)/const char wine_build[] = \"\\1\";/p'\` && (echo \$\$version | cmp -s - \$@) || echo \$\$version >\$@ || (rm -f \$@ && exit 1)
 programs/winetest/build.rc: dummy
 	@build=\"STRINGTABLE { 1 \\\"\`GIT_DIR=${wine_srcdir}.git git rev-parse HEAD 2>/dev/null\`\\\" }\" && (echo \$\$build | cmp -s - \$@) || echo \$\$build >\$@ || (rm -f \$@ && exit 1)
diff --git a/configure.ac b/configure.ac
index 123a778d21f..2ca40da9fb8 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3755,7 +3755,7 @@ WINE_APPEND_RULE(
 [dlls/ntdll/unix/version.c: dummy
 	@base=\`GIT_DIR=${wine_srcdir}.git git describe HEAD 2>/dev/null || echo \"wine-\$(PACKAGE_VERSION)\"\`; \\
 	metalsharp=\`sed -n -e '1{s/^MetalSharp version[[[:space:]]]*//;s/^[[[:space:]]]*//;s/[[[:space:]]]*\$\$//;p;q;}' ${wine_srcdir}METALSHARP_VERSION 2>/dev/null\`; \\
-	test -z \"\$\$metalsharp\" || base=\"\$\$base (MetalSharp \$\$metalsharp)\"; \\
+	test -z \"\$\$metalsharp\" || base=\"\$\$base (MetalSharp Wine \$\$metalsharp)\"; \\
 	version=\`printf '%s\n' \"\$\$base\" | sed -n -e '\$\$s/\(.*\)/const char wine_build[[]] = \"\\1\";/p'\` && (echo \$\$version | cmp -s - \$[@]) || echo \$\$version >\$[@] || (rm -f \$[@] && exit 1)
 programs/winetest/build.rc: dummy
 	@build=\"STRINGTABLE { 1 \\\"\`GIT_DIR=${wine_srcdir}.git git rev-parse HEAD 2>/dev/null\`\\\" }\" && (echo \$\$build | cmp -s - \$[@]) || echo \$\$build >\$[@] || (rm -f \$[@] && exit 1)
