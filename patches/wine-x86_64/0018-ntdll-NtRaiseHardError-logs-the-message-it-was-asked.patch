From f9be52ba4fec5f4cfa835c023eabac687cfa75d4 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Mon, 26 Oct 2026 19:43:52 -0600
Subject: [PATCH 18/59] ntdll: NtRaiseHardError logs the message it was asked
 to show

The function is a stub, so a program that reports a fatal error through it (a MessageBox with
MB_SERVICE_NOTIFICATION) exits with nothing shown. Its text and caption, the UNICODE_STRING
parameters, now go to the fixme log.
---
 dlls/ntdll/unix/system.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
index 5e30f0e1..a06124eb 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4846,7 +4846,14 @@ NTSTATUS WINAPI NtRaiseHardError( NTSTATUS status, ULONG count,
                                   ULONG params_mask, void **params,
                                   HARDERROR_RESPONSE_OPTION option, HARDERROR_RESPONSE *response )
 {
+    ULONG i;
+
     FIXME( "%#08x %u %#x %p %u %p: stub\n", status, count, params_mask, params, option, response );
+    /* The message a program meant to show (MB_SERVICE_NOTIFICATION boxes come here): its text and
+     * caption are the UNICODE_STRING parameters. */
+    for (i = 0; params && i < count && i < 32; i++)
+        if ((params_mask & (1u << i)) && params[i])
+            FIXME( "  param %u: %s\n", i, debugstr_us( (const UNICODE_STRING *)params[i] ));
     return STATUS_NOT_IMPLEMENTED;
 }
 
